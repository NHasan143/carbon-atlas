---
interface Props {
  id?: string;
  title?: string;
  description?: string;
  descriptionId?: string;
  class?: string;
}
const { id, title, description, descriptionId, class: className = '' } = Astro.props;
---

<section id={id} class:list={["atlas-section relative mb-6 px-1 py-8 sm:px-4 sm:py-10 lg:px-6 lg:py-12", className]}>
  {(title || description) && (
    <header class="section-heading mb-8 grid gap-3 border-b border-line pb-7 lg:grid-cols-[minmax(0,1fr)_minmax(260px,0.65fr)] lg:items-end lg:gap-12">
      {title && <h2 class="max-w-[18ch] font-display text-[clamp(30px,4.2vw,50px)] leading-[1.06] font-semibold tracking-[-0.015em] text-balance">{title}</h2>}
      {description && <p id={descriptionId} class="max-w-[62ch] text-[15px] leading-relaxed text-secondary lg:justify-self-end">{description}</p>}
    </header>
  )}
  <slot />
</section>
