---
/**
 * One line of the account, as a chapter. The ledger's line number is not
 * decoration: the running rail refers to it, and the balance below depends on
 * the lines above it, so the sequence carries the reading order — which is why
 * it is set at plate scale beside the title rather than tucked above it.
 */
interface Props {
  id: string;
  line: string;
  title: string;
}
const { id, line, title } = Astro.props;
---

<section id={id} class="ledger-row" data-ledger-row={line} aria-labelledby={`${id}-title`}>
  <header class="ledger-head">
    <p class="ledger-line" aria-hidden="true">{line}</p>
    <h2 id={`${id}-title`} class="ledger-title">{title}</h2>
  </header>
  <div class="ledger-body">
    <slot />
  </div>
</section>

<style>
  .ledger-row {
    position: relative;
    /* The titles size themselves against this width, so it is the container. */
    container-type: inline-size;
    padding: clamp(36px, 5vw, 60px) 0;
    border-top: 1px solid var(--border);
    /* Clears the fixed balance strip, so a deep link does not land under it. */
    scroll-margin-top: 58px;
  }

  @media (min-width: 1100px) {
    .ledger-row { scroll-margin-top: 24px; }
  }

  .ledger-head {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2.2vw, 30px);
    margin-bottom: clamp(24px, 3vw, 34px);
  }

  .ledger-line {
    flex: none;
    font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
    font-size: min(clamp(34px, 5.2vw, 68px), 7.6cqi);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  /* One line at every width: the size falls out of the container, the way the
     atlas sizes a single-line chapter title. */
  .ledger-title {
    min-width: 0;
    font-family: var(--font-display, "Playfair Display Variable", Georgia, serif);
    font-size: min(clamp(26px, 4.4vw, 54px), 6.1cqi);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  /* The reading runs to the width of the ledger blocks beside it. The type
     steps up with the measure: widening a column without growing the type is
     what turns a long line into a tiring one. */
  .ledger-body {
    display: grid;
    gap: 24px;
    max-width: 880px;
  }

  .ledger-body :global(p) {
    font-size: 18px;
    line-height: 1.68;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .ledger-body :global(strong) {
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
