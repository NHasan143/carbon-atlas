---
import GraduationCap from 'lucide-astro/GraduationCap';
import HandCoins from 'lucide-astro/HandCoins';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videoUrl = `${base}/videos/climate-atlas-hero.mp4`;
const posterUrl = `${base}/videos/climate-atlas-hero-poster.jpg`;
const rotatingWords = ['mapped.', 'measured.', 'compared.', 'decoded.'];
---

<header id="top" class="hero relative isolate m-2 min-h-[calc(100svh-16px)] overflow-hidden rounded-[24px] bg-black text-white md:m-4 md:min-h-[calc(100svh-32px)] md:rounded-[32px] lg:h-[calc(100svh-32px)] lg:min-h-[720px]">
  <div class="hero-layout grid min-h-[inherit] w-full content-center gap-y-6 px-6 py-10 sm:gap-y-10 sm:px-10 sm:py-14 lg:h-full lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-x-10 lg:gap-y-0 lg:px-14 lg:py-12 xl:gap-x-14 xl:px-16">
    <div class="hero-copy relative z-10 max-w-[720px] lg:pl-[clamp(0px,2vw,28px)]">
      <h1 class="hero-title leading-[0.9] tracking-[-0.045em] whitespace-nowrap">
        <span class="sr-only">The planet, {rotatingWords[0]}</span>
        <span class="hero-title-line inline-block" aria-hidden="true">The planet,</span>{' '}
        <span class="hero-title-line hero-rotator" aria-hidden="true" data-hero-rotator>
          {rotatingWords.map((word, wordIndex) => (
            <span class:list={['hero-word', { 'is-active': wordIndex === 0 }]} data-hero-word>
              {[...word].map((letter, i) => (
                <span class="hero-letter" style={`--i:${i}`}>{letter}</span>
              ))}
            </span>
          ))}
        </span>
      </h1>

      <p class="mt-8 max-w-[580px] text-[clamp(16px,1.5vw,20px)] leading-relaxed text-[#e1e8ed] sm:mt-10">
        Follow emissions, energy, prosperity, and population across 217 countries and 35 years of global change.
      </p>
      <p class="mt-4 font-mono text-[11px] font-semibold tracking-[0.12em] text-[#9ec5f4] uppercase">
        1990–2024 · Six connected metrics
      </p>
    </div>

    <div class="hero-media relative aspect-[21/20] w-full sm:aspect-[4/3] lg:aspect-auto lg:h-full lg:self-stretch">
      <video
        class="hero-video"
        poster={posterUrl}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src={videoUrl} type="video/mp4" media="(prefers-reduced-motion: no-preference)" />
      </video>
    </div>

    <div class="hero-actions relative z-10 flex w-full max-w-[720px] flex-col items-start gap-3 sm:w-auto sm:flex-row lg:mt-8 lg:ml-[clamp(0px,2vw,28px)]">
      <a
        href={`${base}/knowledge`}
        target="_blank"
        rel="noopener"
        class="hero-button group inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-white/45 bg-black px-7 py-3 text-sm font-semibold text-white no-underline sm:w-auto"
        aria-label="Why it is getting warmer (opens in a new tab)"
      >
        <GraduationCap class="size-4 shrink-0" strokeWidth={1.7} aria-hidden="true" />
        Why it is getting warmer
        <svg aria-hidden="true" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none">
          <path d="M6 14 14 6M8 6h6v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        href="https://wise.com/pay/me/mdnaymulh4"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-button group inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-white/45 bg-black px-7 py-3 text-sm font-semibold text-white no-underline sm:w-auto"
        aria-label="Donate via Wise (opens in a new tab)"
      >
        <HandCoins class="size-4 shrink-0" strokeWidth={1.7} aria-hidden="true" />
        Donate
        <svg aria-hidden="true" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none">
          <path d="M6 14 14 6M8 6h6v6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .hero {
    box-shadow: 0 28px 70px -36px rgb(3 15 25 / 0.8);
  }

  /* Mobile reads top to bottom: headline, video, then the actions.
     From lg the copy and actions share the left column, centred beside the media. */
  .hero-copy { grid-area: copy; }
  .hero-media { grid-area: media; }
  .hero-actions { grid-area: actions; }

  /* The video already separates copy from actions on small screens;
     the rule only earns its place beside it on desktop. */
  @media (min-width: 1024px) {
    .hero-actions {
      position: relative;
      padding-top: 1.75rem;
    }

    .hero-actions::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 5rem;
      height: 1px;
      background: oklch(75% 0.25 145 / 0.8);
    }
  }

  .hero-layout {
    grid-template-areas: 'copy' 'media' 'actions';
  }

  @media (min-width: 1024px) {
    .hero-layout {
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: '. media' 'copy media' 'actions media' '. media';
    }
  }

  .hero-copy {
    container-type: inline-size;
    animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both 120ms;
  }

  .hero-title {
    font-family: 'Google Sans Variable', 'Google Sans', sans-serif;
    font-weight: 400;
    /* Sized from the copy column so the longest line ("The planet, compared.") holds one line. */
    font-size: clamp(24px, 10.6cqi, 96px);
  }

  /* The subject sits centred on black, so size the frame by height and let
     its empty sides spill past the column: the plant fills the column width. */
  .hero-media {
    container-type: size;
  }

  .hero-video {
    position: absolute;
    top: 50%;
    left: 50%;
    height: min(100cqh, 88cqw);
    width: auto;
    max-width: none;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    translate: -50% -50%;
    mask-image:
      linear-gradient(to right, transparent 4%, #000 16%, #000 84%, transparent 96%),
      linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  @media (min-width: 1024px) {
    .hero-video { height: min(88cqh, 88cqw); }
  }

  .hero-title-line {
    animation: title-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-title-line:first-child {
    animation-delay: 180ms;
  }

  /* Every word shares one grid cell, so the line is always as wide as the
     longest word and nothing shifts when the word changes. */
  .hero-rotator {
    display: inline-grid;
    animation-delay: 320ms;
  }

  .hero-word {
    grid-area: 1 / 1;
  }

  .hero-letter {
    display: inline-block;
    /* Extend the clipped background below the 0.9 line box so descenders keep their fill. */
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    background: linear-gradient(180deg, oklch(100% 0 0) 0%, oklch(85% 0.1 150) 100%);
    background-clip: text;
    text-shadow:
      0 0 45px oklch(75% 0.25 145 / 0.35),
      0 0 15px oklch(75% 0.25 145 / 0.15);
    color: transparent;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    transform: translateY(0.22em);
    filter: blur(8px);
    transition:
      opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1300ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 1200ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 45ms + 380ms);
  }

  .is-active .hero-letter {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  .is-leaving .hero-letter {
    opacity: 0;
    transform: translateY(-0.14em);
    filter: blur(8px);
    transition-duration: 700ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    transition-delay: calc(var(--i) * 28ms);
  }

  .hero-actions {
    animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both 260ms;
  }

  .hero-media {
    animation: media-reveal 1100ms cubic-bezier(0.16, 1, 0.3, 1) both 180ms;
  }

  @keyframes hero-rise {
    from { opacity: 0.01; transform: translateY(34px); filter: blur(8px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @keyframes title-rise {
    from { opacity: 0.01; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes media-reveal {
    from { opacity: 0.01; transform: translateX(34px) scale(0.97); filter: blur(10px); }
    to { opacity: 1; transform: translateX(0) scale(1); filter: blur(0); }
  }

  .hero-button {
    box-shadow: 0 12px 30px -16px rgb(0 0 0 / 0.7);
    transition:
      transform 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .hero-button:hover {
    transform: scale(1.05);
    border-color: oklch(75% 0.25 145 / 0.8);
    background-color: #000;
    box-shadow:
      0 0 0 1px oklch(75% 0.25 145 / 0.36),
      0 0 28px oklch(75% 0.25 145 / 0.48),
      0 18px 44px -14px oklch(75% 0.25 145 / 0.62);
  }

  .hero-button:focus-visible {
    border-color: oklch(75% 0.25 145 / 0.8);
    outline-color: var(--action-accent);
    box-shadow:
      0 0 0 1px oklch(75% 0.25 145 / 0.36),
      0 0 28px oklch(75% 0.25 145 / 0.48);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-actions,
    .hero-title-line,
    .hero-media { animation: none; }
    .hero-letter { transition: none; }
    .hero-button,
    .hero-button svg { transition: none; }
  }
</style>

<script>
  const rotator = document.querySelector('[data-hero-rotator]');
  const words = rotator ? [...rotator.querySelectorAll<HTMLElement>('[data-hero-word]')] : [];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const INTERVAL = 3600;

  if (rotator && words.length > 1) {
    let index = 0;
    let timer = 0;
    let inView = true;

    const advance = () => {
      const leaving = words[index];
      index = (index + 1) % words.length;
      leaving.classList.replace('is-active', 'is-leaving');
      words[index].classList.remove('is-leaving');
      words[index].classList.add('is-active');
      // Drop the leaving state once it has faded, so the word re-enters from below next time.
      window.setTimeout(() => leaving.classList.remove('is-leaving'), 1200);
    };

    const sync = () => {
      const shouldRun = inView && !document.hidden && !reducedMotion.matches;
      if (shouldRun && !timer) timer = window.setInterval(advance, INTERVAL);
      if (!shouldRun && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    };

    // Pause while the hero is off screen or the tab is hidden.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        sync();
      }).observe(rotator);
    }
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    sync();
  }
</script>
