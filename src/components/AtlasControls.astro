---
import Panel from './Panel.astro';
const colors = ['var(--accent)', 'var(--accent-2)', 'var(--accent-3)'];
---

<Panel id="controlsPanel">
  <p id="loadStatus" role="status" class="mb-3">Loading the atlas…</p>
  <p id="loadRetry" hidden class="mb-3"><a href="" class="text-accent underline">Reload the atlas</a></p>
  <noscript><p class="mb-3">Enable JavaScript to explore the charts and compare countries.</p></noscript>
  <div class="flex flex-wrap items-end gap-x-[26px] gap-y-[18px]">
    <div class="flex min-w-0 flex-[1_1_320px] items-center gap-3.5">
      <button id="playBtn" type="button" aria-label="Play animation" aria-pressed="false" disabled class="flex min-w-[76px] shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-accent px-4 py-[9px] text-[13px] font-semibold text-white hover:brightness-110">
        <svg id="playIcon" aria-hidden="true" class="size-3" viewBox="0 0 12 12" fill="currentColor"><path d="M2 1 11 6 2 11Z" /></svg>
        <svg id="pauseIcon" aria-hidden="true" class="size-3" style="display:none" viewBox="0 0 12 12" fill="currentColor"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
        <span id="playLabel">Play</span>
      </button>
      <div class="flex min-w-0 flex-auto items-center gap-3">
        <input type="range" id="yearSlider" min="0" max="33" step="1" value="33" aria-label="Year" disabled />
        <span id="yearReadout" class="min-w-[3.4em] text-right font-mono text-base font-semibold tabular-nums">2023</span>
      </div>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap gap-x-[22px] gap-y-3.5">
    {colors.map((color, slot) => (
      <div class="flex min-w-0 flex-col gap-1.5 max-sm:basis-full">
        <label for={`cmp${slot}`} class="text-[11.5px] font-semibold tracking-[0.03em] text-muted uppercase">Compare — series {slot + 1}</label>
        <div class="flex items-center gap-2">
          <span class="swatch" style={{ background: color }}></span>
          <select id={`cmp${slot}`} class="max-sm:flex-1" disabled></select>
        </div>
      </div>
    ))}
  </div>
  <p class="mt-2.5 text-[12.5px] leading-normal text-muted">Highlighted countries stay in the same three colors across every chart below. Everything else is shown in gray for context — that cap keeps colors tell-apart-able (a fourth or fifth hue starts to look the same to some readers).</p>
</Panel>
