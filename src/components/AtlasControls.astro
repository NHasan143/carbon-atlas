---
import Check from 'lucide-astro/Check';
import Facebook from 'lucide-astro/Facebook';
import Link from 'lucide-astro/Link';
import Linkedin from 'lucide-astro/Linkedin';
import Mail from 'lucide-astro/Mail';
import MessageCircle from 'lucide-astro/MessageCircle';
import Share2 from 'lucide-astro/Share2';
import Twitter from 'lucide-astro/Twitter';
import X from 'lucide-astro/X';
import Panel from './Panel.astro';

const colors = ['var(--accent)', 'var(--accent-2)', 'var(--accent-3)'];

// Each target is a plain link whose href the script writes at open time, so a
// shared link always carries the countries, year and metrics currently on
// screen and nothing third-party loads until a destination is chosen. Lucide
// ships no mark for X or WhatsApp, so those two borrow its nearest glyph and
// the visible label carries the name.
const shareTargets = [
  { id: 'x', label: 'Post on X', Icon: Twitter },
  { id: 'facebook', label: 'Share on Facebook', Icon: Facebook },
  { id: 'linkedin', label: 'Share on LinkedIn', Icon: Linkedin },
  { id: 'whatsapp', label: 'Send on WhatsApp', Icon: MessageCircle },
  { id: 'email', label: 'Email the link', Icon: Mail },
];
---

<Panel id="controlsPanel" title="Compare three countries" description="Choose the places and year you want to examine. Every view below updates from this shared control room." class="controls-section">
  <p id="loadStatus" role="status" class="mb-3">Loading the atlas…</p>
  <p id="loadRetry" hidden class="mb-3"><a href="" class="text-accent underline">Reload the atlas</a></p>
  <noscript><p class="mb-3">Enable JavaScript to explore the charts and compare countries.</p></noscript>
  <div class="rounded-xl bg-field px-4 py-5 sm:px-6">
    <div class="flex min-w-0 items-center gap-3.5">
      <button id="playBtn" type="button" aria-label="Play animation" aria-pressed="false" disabled class="flex min-w-[76px] shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-[var(--action-accent)] px-4 py-[9px] text-[13px] font-semibold text-[#071018] hover:brightness-110">
        <svg id="playIcon" aria-hidden="true" class="size-3" viewBox="0 0 12 12" fill="currentColor"><path d="M2 1 11 6 2 11Z" /></svg>
        <svg id="pauseIcon" aria-hidden="true" class="size-3" style="display:none" viewBox="0 0 12 12" fill="currentColor"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
        <span id="playLabel">Play</span>
      </button>
      <div class="flex min-w-0 flex-auto items-center gap-3">
        <input type="range" id="yearSlider" min="0" max="34" step="1" value="34" aria-label="Year" disabled />
        <span id="yearReadout" class="min-w-[3.4em] text-right font-mono text-lg font-semibold tabular-nums">2024</span>
      </div>
    </div>
  </div>
  <div class="mt-6 grid gap-3 md:grid-cols-3">
    {colors.map((color, slot) => (
      <div class="country-control flex min-w-0 flex-col gap-3 rounded-xl border border-line bg-field p-4">
        <div class="flex items-center justify-between gap-3">
          <label id={`cmp${slot}Label`} for={`cmp${slot}`} class="text-xs font-semibold text-secondary">Country {slot + 1}</label>
          <span class="swatch" style={{ background: color }}></span>
        </div>
        <div class="combo" data-slot={slot}>
          <svg class="combo-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <circle cx="7" cy="7" r="4.25" /><path d="m10.2 10.2 3.05 3.05" />
          </svg>
          <input
            type="text"
            id={`cmp${slot}`}
            class="combo-input"
            role="combobox"
            placeholder="Type a country name"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            aria-expanded="false"
            aria-autocomplete="list"
            aria-controls={`cmp${slot}List`}
            aria-describedby={`cmp${slot}Hint`}
            disabled
          />
          <button type="button" id={`cmp${slot}Clear`} class="combo-clear" aria-label={`Clear country ${slot + 1}`} hidden>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="m5 5 6 6M11 5l-6 6" />
            </svg>
          </button>
          <div class="combo-pop" id={`cmp${slot}Pop`} hidden>
            <div class="combo-list" id={`cmp${slot}List`} role="listbox" aria-labelledby={`cmp${slot}Label`}></div>
            <p class="combo-empty" id={`cmp${slot}Empty`} hidden></p>
          </div>
        </div>
        <p id={`cmp${slot}Hint`} class="sr-only">Type to search 217 countries and territories by name or three-letter code. Use the up and down arrow keys to move through the results, Enter to choose, Escape to close.</p>
        <p id={`cmp${slot}Status`} class="sr-only" role="status"></p>
      </div>
    ))}
  </div>
  <div class="mt-5 flex flex-col gap-4 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
    <p class="max-w-[85ch] text-[12.5px] leading-relaxed text-muted">Highlighted countries keep these three colors across every chart below. Everything else appears in gray for context; three distinct hues remain easier to tell apart than a larger palette.</p>
    <div class="share-actions flex min-w-0 flex-wrap items-center justify-center gap-3 sm:shrink-0 sm:justify-end">
      <button
        id="shareViewBtn"
        type="button"
        disabled
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="sharePop"
        class="glow-button inline-flex min-h-11 items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2 text-[13px] font-semibold text-ink"
      >
        <Share2 class="size-4 shrink-0" strokeWidth={1.6} aria-hidden="true" />
        Share this view
      </button>
      <span id="shareViewStatus" role="status" class="sr-only" aria-live="polite"></span>

      <div class="share-pop" id="sharePop" role="dialog" aria-labelledby="sharePopTitle" hidden>
        <div class="share-pop-head">
          <h3 class="share-pop-title" id="sharePopTitle">Share this view</h3>
          <button type="button" id="sharePopClose" class="share-close" aria-label="Close the share options">
            <X class="size-4" strokeWidth={1.6} aria-hidden="true" />
          </button>
        </div>

        <p class="share-note">Your three countries, the year and every metric choice travel in the link.</p>

        <div class="share-link">
          <span class="share-url" id="shareUrlPreview" title="">—</span>
          <button type="button" id="shareCopyBtn" class="share-copy">
            <Link class="size-4 shrink-0 share-copy-idle" strokeWidth={1.6} aria-hidden="true" />
            <Check class="size-4 shrink-0 share-copy-done" strokeWidth={1.6} aria-hidden="true" />
            <span class="share-copy-label">Copy</span>
          </button>
        </div>

        <ul class="share-list">
          {shareTargets.map(({ id, label, Icon }) => (
            <li>
              <a class="share-target" data-share-target={id} href="#" rel="noopener">
                <Icon class="size-4 shrink-0" strokeWidth={1.6} aria-hidden="true" />
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Panel>
