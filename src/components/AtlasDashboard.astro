---
import AtlasControls from './AtlasControls.astro';
import BackToTop from './BackToTop.astro';
import Hero from './Hero.astro';
import MetricSelect from './MetricSelect.astro';
import Panel from './Panel.astro';
---

  <Hero />
  <BackToTop />

  <div class="atlas-shell mx-auto max-w-[1280px] px-4 pt-20 pb-6 sm:px-6 lg:pt-28">
    <AtlasControls />

    <Panel id="nowComparing" title="The Comparison" description="A precise snapshot of every atlas metric for your selected countries and year. Arrows show the change from the year before: green is better for the planet, red is worse." class="snapshot-section">
      <div class="section-toolbar">
        <span>Selected year</span>
        <strong data-year-output>2024</strong>
      </div>
      <div class="table-frame">
        <p id="compareScrollHint" class="table-scroll-hint">Swipe sideways to see every metric. Country names stay pinned.</p>
        <div class="table-scroll overflow-x-auto">
          <table class="compare" id="compareTable" aria-label="Country metrics for the selected year" aria-describedby="compareScrollHint"></table>
        </div>
        <p id="compareEmpty" class="empty-note" hidden>Pick at least one country above.</p>
      </div>
    </Panel>

    <Panel id="worldMap" title="The World View" description="Move from a single value to the global pattern. Every country is held to one consistent scale across time." descriptionId="choroSub" class="map-section">
      <div class="map-layout grid gap-6 lg:grid-cols-[230px_minmax(0,1fr)] lg:items-stretch">
        <aside class="chart-sidebar flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5 lg:flex-col lg:flex-nowrap lg:items-stretch lg:justify-start lg:gap-8">
          <MetricSelect id="choroMetric" label="Map metric" />
          <div class="map-focus max-lg:order-last max-lg:basis-full">
            <span class="block text-xs font-semibold text-muted">Your countries</span>
            <ol id="choroFocus" class="mt-3 grid gap-3 lg:gap-4" aria-live="polite"></ol>
          </div>
          <div class="lg:mt-auto">
            <span class="block text-xs font-semibold text-muted">Selected year</span>
            <strong class="mt-1 block font-mono text-3xl tabular-nums" data-year-output>2024</strong>
          </div>
        </aside>
        <div class="chart-stage min-w-0 rounded-xl border border-line bg-surface p-2 sm:p-4">
          <div id="choroplethChart" class="h-[250px] w-full sm:h-[380px] lg:h-[500px]" role="img" aria-label="World map of the selected metric"></div>
        </div>
      </div>
      <p id="choroCaption" class="mx-auto mt-5 max-w-[90ch] text-center text-[12.5px] leading-relaxed text-balance text-muted"></p>
    </Panel>

    <Panel id="relationship" title="GDP, Emissions and Population" singleLine description="Each bubble is a country and its area represents population. Change either axis to test a different relationship." class="relationship-section">
      <div class="chart-toolbar mb-6 flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5">
        <div class="flex flex-1 flex-wrap gap-4">
          <MetricSelect id="scatterX" label="Horizontal axis" />
          <MetricSelect id="scatterY" label="Vertical axis" />
        </div>
        <div class="text-right">
          <span class="block text-xs font-semibold text-muted">Selected year</span>
          <strong class="mt-1 block font-mono text-2xl tabular-nums" data-year-output>2024</strong>
        </div>
      </div>
      <div class="chart-stage min-w-0 rounded-xl border border-line bg-surface p-2 sm:p-4">
        <div id="scatterChart" class="h-[500px] w-full sm:h-[620px]" aria-label="Country metric and population comparison"></div>
      </div>
    </Panel>

    <Panel id="trends" title="The Trends Side by Side" description="Read the complete 1990–2024 record for the same countries. The dashed marker keeps your selected year visible across every metric." class="trends-section">
      <div class="section-toolbar mb-6">
        <span>Cross-chart marker</span>
        <strong data-year-output>2024</strong>
      </div>
      <div id="smGrid" class="trend-grid grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
    </Panel>

    <footer class="mx-auto mt-12 max-w-[1000px] border-t border-line pt-8 text-[12.5px] leading-[1.7] text-muted">
      <p>
      Data: <a class="text-secondary underline" href="https://github.com/owid/co2-data" target="_blank" rel="noopener">Our World in Data – CO₂ and Greenhouse Gas Emissions</a> and{' '}
      <a class="text-secondary underline" href="https://github.com/owid/energy-data" target="_blank" rel="noopener">Our World in Data – Energy</a>, and{' '}
      <a class="text-secondary underline" href="https://ourworldindata.org/grapher/gdp-per-capita-worldbank" target="_blank" rel="noopener">World Bank – GDP per capita, PPP (constant 2021 international $)</a> via Our World in Data, all CC BY. Renewables-share data covers 79 countries with reliable energy-mix reporting; others show as no-data on the map and are omitted from that metric's comparisons.
      </p>
      <p class="mt-6 flex items-center justify-center gap-1 text-[13px] text-secondary">
        Made with
        <svg class="size-3.5 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor" role="img" aria-label="love">
          <path d="M10 17.5s-6.5-3.9-6.5-8.6A3.7 3.7 0 0 1 10 6.6a3.7 3.7 0 0 1 6.5 2.3c0 4.7-6.5 8.6-6.5 8.6Z" />
        </svg>
        by <a class="text-ink underline decoration-accent underline-offset-4" href="https://github.com/NHasan143" target="_blank" rel="noopener noreferrer">Naymul Hasan</a>
      </p>
    </footer>
  </div>

<script>
import type { Data, Layout, Shape, Annotations, ScatterLine, PlotlyHTMLElement } from 'plotly.js';

interface Country { iso3: string; name: string; continent: string; }
interface AtlasData {
  years: number[];
  countries: Country[];
  metrics: Record<string, Record<string, (number | null)[]>>;
  metricMeta: Record<string, { label: string; unit: string; vmax: number }>;
}
interface Bubble { x: number; y: number; size: number; text: string; }
interface TrendTrace {
  type: 'scatter';
  mode: 'lines';
  name: string;
  x: number[];
  y: number[];
  line: Partial<ScatterLine> & { color: string };
  hovertemplate: string;
  showlegend: boolean;
}

function element<T extends HTMLElement = HTMLElement>(id: string): T {
  const node = document.getElementById(id);
  if (!node) throw new Error(`Missing atlas element: ${id}`);
  return node as T;
}

function initAtlas(){
  let Plotly: typeof import('plotly.js');

  let DATA: AtlasData;
  let YEARS: number[] = [];
  const COUNTRIES_BY_ISO: Record<string, Country> = {};
  let COUNTRIES_SORTED: Country[] = [];
  // ISO codes that have a shape in world_110m.json. Plotly's hover throws on
  // any location it cannot draw, so every map layer lists only these.
  let MAP_ISOS = new Set<string>();
  let MAP_COUNTRIES: Country[] = [];
  var currentYearIdx = 0;
  var highlighted = ["USA","CHN","IND"]; // slot order = series 1/2/3
  var choroMetric = "co2_per_capita";
  var scatterXMetric = "gdp_per_capita";
  var scatterYMetric = "co2_per_capita";
  var maxPopulation = 1;
  let playTimer: ReturnType<typeof setInterval> | null = null;

  function getVar(name: string){
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  function theme(){
    return {
      surface: getVar("--surface"),
      surface2: getVar("--surface-2"),
      text: getVar("--text-primary"),
      textSecondary: getVar("--text-secondary"),
      textMuted: getVar("--text-muted"),
      grid: getVar("--grid"),
      axis: getVar("--axis"),
      border: getVar("--border"),
      context: getVar("--context-dot"),
      seq: [getVar("--seq-100"),getVar("--seq-200"),getVar("--seq-300"),getVar("--seq-400"),getVar("--seq-500"),getVar("--seq-600"),getVar("--seq-700")],
      series: [getVar("--accent"), getVar("--accent-2"), getVar("--accent-3")],
      fontFamily: "IBM Plex Sans, system-ui, sans-serif"
    };
  }

  function fmtValue(v: number | null | undefined, metric: string){
    if (v === null || v === undefined || isNaN(v)) return "—";
    if (metric === "co2_per_capita") return v.toFixed(2) + " t";
    if (metric === "co2") return v.toLocaleString(undefined,{maximumFractionDigits:0}) + " Mt";
    if (metric === "share_global_co2") return v.toFixed(2) + "%";
    if (metric === "gdp_per_capita") return "$" + v.toLocaleString(undefined,{maximumFractionDigits:0});
    if (metric === "renewables_share_energy") return v.toFixed(1) + "%";
    if (metric === "population") return v.toLocaleString(undefined,{maximumFractionDigits:0});
    return String(v);
  }

  function metricLabel(metric: string){
    var m = DATA.metricMeta[metric];
    return m ? (m.label + " (" + m.unit + ")") : metric;
  }

  function seriesAt(iso: string, metric: string){
    var m = DATA.metrics[metric];
    return m ? (m[iso] || null) : null;
  }

  function valueAt(iso: string, metric: string, yearIdx: number){
    var s = seriesAt(iso, metric);
    return s ? s[yearIdx] : null;
  }

  function axisType(metric: string){
    return (metric === "gdp_per_capita" || metric === "population") ? "log" : "linear";
  }

  // ---------- bootstrap ----------
  function setControlsEnabled(enabled: boolean){
    document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>("#controlsPanel button, #controlsPanel input, #controlsPanel select, #choroMetric, #scatterX, #scatterY").forEach(function(control){
      control.disabled = !enabled;
    });
  }

  setControlsEnabled(false);
  const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  Promise.all([
    import("plotly.js-dist-min").then(function(module){
      Plotly = module.default;
    }).catch(function(){
      throw new Error("The chart library could not load. Reload the atlas to try again.");
    }),
    // Same file Plotly draws from, so its own request is served from cache.
    fetch(assetBase + "world_110m.json").then(function(response){
      if (!response.ok) throw new Error("HTTP " + response.status);
      return response.json() as Promise<{ objects: { countries: { geometries: { id?: string }[] } } }>;
    }).then(function(topo){
      topo.objects.countries.geometries.forEach(function(g){ if (g.id) MAP_ISOS.add(g.id); });
    }).catch(function(){
      throw new Error("The map could not load. Check your connection and reload the atlas.");
    }),
    fetch(assetBase + "dataset.json").then(function(response){
      if (!response.ok) throw new Error("HTTP " + response.status);
      return response.json() as Promise<AtlasData>;
    }).catch(function(){
      throw new Error("The atlas data could not load. Check your connection and reload the atlas.");
    })
  ]).then(function([, , d]){
    DATA = d;
    YEARS = d.years;
    d.countries.forEach(function(c){ COUNTRIES_BY_ISO[c.iso3] = c; });
    COUNTRIES_SORTED = d.countries.slice().sort(function(a,b){ return a.name.localeCompare(b.name); });
    MAP_COUNTRIES = COUNTRIES_SORTED.filter(function(c){ return MAP_ISOS.has(c.iso3); });

    Object.keys(d.metrics).forEach(function(metric){
      Object.keys(d.metrics[metric]).forEach(function(iso){
        d.metrics[metric][iso].forEach(function(v){
          if (metric === "population" && v && v > maxPopulation) maxPopulation = v;
        });
      });
    });

    currentYearIdx = YEARS.length - 1;
    element<HTMLInputElement>("yearSlider").max = String(YEARS.length - 1);
    element<HTMLInputElement>("yearSlider").value = String(currentYearIdx);
    element("yearReadout").textContent = String(YEARS[currentYearIdx]);

    buildMetricDropdown(element<HTMLSelectElement>("choroMetric"), choroMetric);
    buildMetricDropdown(element<HTMLSelectElement>("scatterX"), scatterXMetric);
    buildMetricDropdown(element<HTMLSelectElement>("scatterY"), scatterYMetric);
    buildCompareDropdowns();

    updateCompareTable();
    return Promise.all([renderChoropleth(), renderScatter(), renderSmallMultiples()]);
  }).then(function(){
    wireEvents();
    setControlsEnabled(true);
    element("loadStatus").hidden = true;
  }).catch(function(error){
    console.error("Atlas initialization failed:", error);
    setControlsEnabled(false);
    var status = element("loadStatus");
    status.textContent = error.message;
    status.hidden = false;
    element("loadRetry").hidden = false;
  });

  function buildMetricDropdown(sel: HTMLSelectElement, selected: string){
    sel.innerHTML = "";
    Object.keys(DATA.metricMeta).forEach(function(key){
      var opt = document.createElement("option");
      opt.value = key;
      opt.textContent = DATA.metricMeta[key].label;
      if (key === selected) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  function buildCompareDropdowns(){
    const byContinent: Record<string, Country[]> = {};
    COUNTRIES_SORTED.forEach(function(c){
      (byContinent[c.continent] = byContinent[c.continent] || []).push(c);
    });
    var continents = Object.keys(byContinent).sort();

    [0,1,2].forEach(function(slot){
      var sel = element<HTMLSelectElement>("cmp" + slot);
      sel.innerHTML = "";
      var noneOpt = document.createElement("option");
      noneOpt.value = ""; noneOpt.textContent = "— none —";
      sel.appendChild(noneOpt);
      continents.forEach(function(cont){
        var group = document.createElement("optgroup");
        group.label = cont;
        byContinent[cont].forEach(function(c){
          var opt = document.createElement("option");
          opt.value = c.iso3; opt.textContent = c.name;
          group.appendChild(opt);
        });
        sel.appendChild(group);
      });
      sel.value = highlighted[slot] || "";
    });
  }

  function wireEvents(){
    element<HTMLInputElement>("yearSlider").addEventListener("input", function(e){
      currentYearIdx = parseInt((e.currentTarget as HTMLInputElement | HTMLSelectElement).value, 10);
      onYearChange();
    });
    element("playBtn").addEventListener("click", togglePlay);
    element<HTMLSelectElement>("choroMetric").addEventListener("change", function(e){
      choroMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderChoropleth();
    });
    element<HTMLSelectElement>("scatterX").addEventListener("change", function(e){
      scatterXMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderScatter();
    });
    element<HTMLSelectElement>("scatterY").addEventListener("change", function(e){
      scatterYMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderScatter();
    });
    [0,1,2].forEach(function(slot){
      element<HTMLSelectElement>("cmp" + slot).addEventListener("change", function(e){
        var iso = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
        // avoid duplicate picks across slots
        [0,1,2].forEach(function(other){
          if (other !== slot && highlighted[other] === iso && iso !== "") {
            highlighted[other] = "";
            element<HTMLSelectElement>("cmp" + other).value = "";
          }
        });
        highlighted[slot] = iso;
        renderChoropleth();
        renderScatter();
        renderSmallMultiples();
        updateCompareTable();
      });
    });

    var mq = window.matchMedia("(prefers-color-scheme: dark)");
    if (mq.addEventListener) mq.addEventListener("change", reTheme);
    new MutationObserver(reTheme).observe(document.documentElement, {attributes:true, attributeFilter:["data-theme"]});
  }

  function reTheme(){
    renderChoropleth();
    renderScatter();
    renderSmallMultiples();
  }

  function setPlayState(playing: boolean){
    element("playLabel").textContent = playing ? "Pause" : "Play";
    element("playIcon").style.display = playing ? "none" : "block";
    element("pauseIcon").style.display = playing ? "block" : "none";
    element("playBtn").setAttribute("aria-pressed", String(playing));
  }

  function updateYearOutputs(){
    document.querySelectorAll<HTMLElement>("[data-year-output]").forEach(function(output){
      output.textContent = String(YEARS[currentYearIdx]);
    });
  }

  function stopPlayback(){
    if (playTimer) clearInterval(playTimer);
    playTimer = null;
    setPlayState(false);
    element("playBtn").setAttribute("aria-label", "Play animation");
  }

  function setYear(idx: number){
    currentYearIdx = idx;
    element<HTMLInputElement>("yearSlider").value = String(currentYearIdx);
    onYearChange();
  }

  // Play runs a single pass up to the latest year, then stops. Starting from
  // the latest year rewinds to the first so the pass covers the full record.
  function togglePlay(){
    if (playTimer){
      stopPlayback();
      return;
    }
    var lastIdx = YEARS.length - 1;
    if (currentYearIdx >= lastIdx) setYear(0);
    setPlayState(true);
    element("playBtn").setAttribute("aria-label", "Pause animation");
    playTimer = setInterval(function(){
      setYear(Math.min(currentYearIdx + 1, lastIdx));
      if (currentYearIdx >= lastIdx) stopPlayback();
    }, 650);
  }

  function onYearChange(){
    element("yearReadout").textContent = String(YEARS[currentYearIdx]);
    updateYearOutputs();
    updateChoroplethYear();
    updateScatterYear();
    updateSmallMultipleMarkers();
    updateCompareTable();
  }

  // ---------- Choropleth ----------
  function choroplethZ(metric: string){
    return MAP_COUNTRIES.map(function(c){
      var v = valueAt(c.iso3, metric, currentYearIdx);
      return v === null || v === undefined ? null : v;
    });
  }

  function metricRange(metric: string){
    // Capped at the 98th percentile (precomputed) rather than the true max,
    // so a handful of extreme outliers don't wash out every other country's
    // color. Plotly clips anything above zmax to the darkest swatch.
    return [0, DATA.metricMeta[metric].vmax];
  }

  function renderChoropleth(){
    var t = theme();
    var isCompact = window.matchMedia("(max-width: 640px)").matches;
    var locations = MAP_COUNTRIES.map(function(c){ return c.iso3; });
    var z = choroplethZ(choroMetric);
    var range = metricRange(choroMetric);
    var meta = DATA.metricMeta[choroMetric];

    element("choroSub").textContent =
      "Colored by " + meta.label + " (" + meta.unit + ") for the selected year.";
    var noDataNote = choroMetric === "renewables_share_energy"
      ? "Gray countries have no reliable energy-mix data for this metric."
      : "Gray countries have no data for this metric in this year.";
    element("choroCaption").textContent =
      noDataNote + " The color scale caps at the 98th percentile so a few extreme outliers don't wash out everyone else — the highest values are shown pinned to the darkest shade.";

    var trace: Data = {
      type: "choropleth",
      locationmode: "ISO-3",
      locations: locations,
      z: z,
      zmin: range[0],
      zmax: range[1],
      colorscale: [[0,t.seq[0]],[1/6,t.seq[1]],[2/6,t.seq[2]],[3/6,t.seq[3]],[4/6,t.seq[4]],[5/6,t.seq[5]],[1,t.seq[6]]],
      marker: { line: { color: t.surface, width: 0.5 } },
      colorbar: isCompact ? {
        title: { text: meta.unit, font: { color: t.textSecondary, size: 10, family: t.fontFamily } },
        orientation: "h",
        x: 0.5,
        xanchor: "center",
        y: -0.08,
        len: 0.72,
        thickness: 9,
        tickfont: { color: t.textSecondary, size: 9, family: t.fontFamily },
        outlinewidth: 0,
        ...legendTicks(range[1])
      } : {
        title: { text: meta.unit, font: { color: t.textSecondary, size: 11, family: t.fontFamily } },
        tickfont: { color: t.textSecondary, size: 11, family: t.fontFamily },
        outlinewidth: 0, thickness: 12, len: 0.7,
        ...legendTicks(range[1])
      },
      customdata: choroplethLabels(choroMetric),
      hovertemplate: "<b>%{text}</b><br>" + meta.label + ": %{customdata}<extra></extra>",
      hoverlabel: { bgcolor: t.surface, bordercolor: t.border, font: { color: t.text, family: t.fontFamily, size: 12 } },
      text: locations.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; })
    };

    // Countries without a value get their own neutral fill, so "no data"
    // never reads as the lowest shade. (The self-hosted atlas has no land layer.)
    var missing = noDataLocations(choroMetric);
    var noDataTrace = {
      type: "choropleth",
      locationmode: "ISO-3",
      // An empty choropleth breaks Plotly's hover, so hide it when every country reports.
      visible: missing.length > 0,
      locations: missing,
      z: missing.map(function(){ return 1; }),
      colorscale: [[0, t.grid], [1, t.grid]],
      showscale: false,
      marker: { line: { color: t.surface, width: 0.5 } },
      text: missing.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; }),
      hovertemplate: "<b>%{text}</b><br>No data<extra></extra>",
      hoverlabel: trace.hoverlabel
    } as Data;

    // The three selected countries are outlined in their series colours, the
    // same identity they carry in the table, bubble chart and trends.
    // A wider page-coloured stroke underneath keeps each outline legible
    // even where it crosses a fill of the same hue.
    var focusIsos = highlighted.filter(function(iso){ return iso && MAP_ISOS.has(iso); });
    var outline = function(iso: string, color: string, width: number){
      return {
        type: "choropleth",
        locationmode: "ISO-3",
        locations: [iso],
        z: [1],
        colorscale: [[0, "rgba(0,0,0,0)"], [1, "rgba(0,0,0,0)"]],
        showscale: false,
        marker: { line: { color: color, width: width } },
        hoverinfo: "skip"
      } as Data;
    };
    var focusTraces: Data[] = focusIsos.map(function(iso){ return outline(iso, t.surface, 4); })
      .concat(highlighted.map(function(iso, slot){
        return iso && MAP_ISOS.has(iso) ? outline(iso, SERIES_COLORS_LIVE()[slot], 1.8) : null;
      }).filter((trace): trace is Data => trace !== null));

    // showcountries draws every country's outline (from the same self-hosted
    // world_110m.json below), so a country with no value for this metric still
    // reads as "on the map, just uncolored" rather than vanishing into the ocean.
    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface,
      plot_bgcolor: t.surface,
      font: { color: t.text, family: t.fontFamily },
      margin: isCompact ? { l:0, r:0, t:0, b:52 } : { l:0, r:0, t:0, b:0 },
      geo: {
        scope: "world",
        resolution: 110,
        showframe: false,
        showcoastlines: false,
        showland: false,
        showocean: false,
        showcountries: true,
        countrycolor: t.surface,
        showlakes: false,
        projection: { type: "natural earth" },
        // Antarctica carries no data; cropping it gives the inhabited world the room.
        lataxis: { range: [-57, 84] },
        bgcolor: t.surface
      }
    };

    // Plotly's default base-map atlas streams from Plotly's own CDN at draw
    // time; topojsonURL redirects that one request to a same-origin file
    // (world_110m.json, published next to this page) built from Natural Earth
    // 110m data, so nothing is fetched from an external host at runtime.
    updateChoroplethReadout();
    return Plotly.react("choroplethChart", ([trace, noDataTrace] as Data[]).concat(focusTraces), layout, {displayModeBar:false, responsive:true, topojsonURL:assetBase});
  }

  function updateChoroplethYear(){
    var missing = noDataLocations(choroMetric);
    Plotly.restyle("choroplethChart", { z: [choroplethZ(choroMetric)], customdata: [choroplethLabels(choroMetric)] }, [0]);
    Plotly.restyle("choroplethChart", {
      visible: [missing.length > 0],
      locations: [missing],
      z: [missing.map(function(){ return 1; })],
      text: [missing.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; })]
    }, [1]);
    updateChoroplethReadout();
  }

  function noDataLocations(metric: string){
    return MAP_COUNTRIES.filter(function(c){
      var v = valueAt(c.iso3, metric, currentYearIdx);
      return v === null || v === undefined || isNaN(v);
    }).map(function(c){ return c.iso3; });
  }

  function choroplethLabels(metric: string){
    return MAP_COUNTRIES.map(function(c){ return fmtValue(valueAt(c.iso3, metric, currentYearIdx), metric); });
  }

  // Round steps up to the colour cap. The top label carries a "+" because
  // every value above the cap shares the darkest shade.
  function legendTicks(cap: number){
    var raw = cap / 4;
    var pow = Math.pow(10, Math.floor(Math.log10(raw)));
    var m = raw / pow;
    var step = (m < 1.5 ? 1 : m < 3 ? 2 : m < 7 ? 5 : 10) * pow;
    var compact = new Intl.NumberFormat(undefined, { notation: "compact", maximumFractionDigits: 1 });
    var tickvals: number[] = [];
    for (var v = 0; v < cap - step * 0.4; v += step) tickvals.push(v);
    var ticktext = tickvals.map(function(v){ return compact.format(v); });
    tickvals.push(cap);
    ticktext.push(new Intl.NumberFormat(undefined, { notation: "compact", maximumSignificantDigits: 3 }).format(cap) + "+");
    return { tickmode: "array" as const, tickvals: tickvals, ticktext: ticktext };
  }

  function ordinal(n: number){
    var tens = n % 100, ones = n % 10;
    if (tens >= 11 && tens <= 13) return n + "th";
    return n + (ones === 1 ? "st" : ones === 2 ? "nd" : ones === 3 ? "rd" : "th");
  }

  // The exact figure and world rank for each selected country: the map's
  // answer without hovering, and its text alternative for screen readers.
  function updateChoroplethReadout(){
    var year = YEARS[currentYearIdx];
    var meta = DATA.metricMeta[choroMetric];
    var reported = COUNTRIES_SORTED
      .map(function(c){ return valueAt(c.iso3, choroMetric, currentYearIdx); })
      .filter((v): v is number => v !== null && v !== undefined && !isNaN(v));
    var colors = SERIES_COLORS_LIVE();
    var items = highlighted.map(function(iso, slot){
      if (!iso) return "";
      var v = valueAt(iso, choroMetric, currentYearIdx);
      var hasValue = v !== null && v !== undefined && !isNaN(v);
      var rank = hasValue ? reported.filter(function(other){ return other > (v as number); }).length + 1 : 0;
      return '<li class="map-focus-item">' +
        '<span class="swatch" style="background:' + colors[slot] + '"></span>' +
        '<span class="map-focus-name">' + COUNTRIES_BY_ISO[iso].name + '</span>' +
        '<span class="map-focus-value">' + fmtValue(v, choroMetric) + '</span>' +
        '<span class="map-focus-rank">' + (hasValue ? ordinal(rank) + " highest of " + reported.length : "No data for " + year) + '</span></li>';
    }).join("");
    element("choroFocus").innerHTML = items || '<li class="text-[12.5px] text-muted">Pick countries above to see where they rank.</li>';
    element("choroplethChart").setAttribute("aria-label", "World map of " + meta.label + " (" + meta.unit + ") in " + year + ". Values and ranks for your selected countries are listed beside the map.");
  }

  // ---------- Scatter ----------
  function scatterFrameData(){
    const contextIso: string[] = [], contextX: number[] = [], contextY: number[] = [], contextSize: number[] = [], contextText: string[] = [];
    const seriesData: Bubble[][] = [[],[],[]]; // per highlighted slot: {iso,x,y,size,text}

    COUNTRIES_SORTED.forEach(function(c){
      var x = valueAt(c.iso3, scatterXMetric, currentYearIdx);
      var y = valueAt(c.iso3, scatterYMetric, currentYearIdx);
      var pop = valueAt(c.iso3, "population", currentYearIdx);
      if (x === null || y === null || x === undefined || y === undefined) return;
      if (x <= 0 && axisType(scatterXMetric) === "log") return;
      if (y <= 0 && axisType(scatterYMetric) === "log") return;
      var slot = highlighted.indexOf(c.iso3);
      var size = pop || (maxPopulation * 0.002);
      if (slot === -1){
        contextIso.push(c.iso3); contextX.push(x); contextY.push(y); contextSize.push(size); contextText.push(c.name);
      } else {
        seriesData[slot].push({x:x,y:y,size:size,text:c.name});
      }
    });
    return { contextX:contextX, contextY:contextY, contextSize:contextSize, contextText:contextText, seriesData:seriesData };
  }

  function bubbleSizeref(){
    return 2.0 * maxPopulation / Math.pow(46, 2);
  }

  function renderScatter(){
    var t = theme();
    var f = scatterFrameData();
    var xMeta = DATA.metricMeta[scatterXMetric], yMeta = DATA.metricMeta[scatterYMetric];

    var traces: Data[] = [{
      type: "scattergl", mode: "markers", name: "Other countries",
      x: f.contextX, y: f.contextY, text: f.contextText,
      marker: { size: f.contextSize, sizemode:"area", sizeref: bubbleSizeref(), sizemin:3,
                color: t.context, opacity:0.55, line:{width:0} },
      hovertemplate: "%{text}<br>" + xMeta.label + ": %{x}<br>" + yMeta.label + ": %{y}<extra></extra>",
      showlegend:false
    }];

    [0,1,2].forEach(function(slot){
      var iso = highlighted[slot];
      if (!iso) return;
      var rows = f.seriesData[slot];
      if (!rows.length) return;
      traces.push({
        type:"scattergl", mode:"text+markers", name: COUNTRIES_BY_ISO[iso].name,
        x: rows.map(function(r){return r.x;}), y: rows.map(function(r){return r.y;}),
        text: rows.map(function(r){return r.text;}), textposition:"top center",
        textfont: { color: t.text, size: 11, family: t.fontFamily },
        marker: { size: rows.map(function(r){return r.size;}), sizemode:"area", sizeref: bubbleSizeref(), sizemin:6,
                  color: SERIES_COLORS_LIVE()[slot], line:{ color:t.surface, width:1.5 } },
        hovertemplate: "<b>%{text}</b><br>" + xMeta.label + ": %{x}<br>" + yMeta.label + ": %{y}<extra></extra>",
        showlegend:false
      });
    });

    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface, plot_bgcolor: t.surface,
      font: { color: t.textSecondary, family: t.fontFamily, size:12 },
      margin: { l:64, r:20, t:10, b:52 },
      xaxis: { title:{text:metricLabel(scatterXMetric)}, type:axisType(scatterXMetric),
                gridcolor:t.grid, zerolinecolor:t.axis, linecolor:t.axis, tickfont:{color:t.textSecondary} },
      yaxis: { title:{text:metricLabel(scatterYMetric)}, type:axisType(scatterYMetric),
                gridcolor:t.grid, zerolinecolor:t.axis, linecolor:t.axis, tickfont:{color:t.textSecondary} }
    };

    return Plotly.react("scatterChart", traces, layout, {displayModeBar:false, responsive:true});
  }

  function SERIES_COLORS_LIVE(){
    return [getVar("--accent"), getVar("--accent-2"), getVar("--accent-3")];
  }

  function updateScatterYear(){
    renderScatter();
  }

  // ---------- Small multiples ----------
  // Row one: emissions. Row two: the economy, people, and energy context behind them.
  var SM_METRICS = ["co2_per_capita","co2","share_global_co2","gdp_per_capita","population","renewables_share_energy"];

  function renderSmallMultiples(){
    var grid = element("smGrid");
    var anyHighlighted = highlighted.some(function(i){ return !!i; });
    if (!anyHighlighted){
      grid.innerHTML = '<p class="empty-note">Pick at least one country above to see its trends.</p>';
      return;
    }
    if (grid.children.length !== SM_METRICS.length || grid.dataset.built !== "1"){
      grid.innerHTML = "";
      SM_METRICS.forEach(function(metric){
        var cell = document.createElement("div");
        cell.className = "sm-cell";
        cell.innerHTML = '<p class="sm-title">'+DATA.metricMeta[metric].label+' ('+DATA.metricMeta[metric].unit+')</p>' +
                          '<div class="chart-sm" id="sm-'+metric+'"></div>';
        grid.appendChild(cell);
      });
      grid.dataset.built = "1";
    }
    return Promise.all(SM_METRICS.map(renderSmallMultiple));
  }

  function renderSmallMultiple(metric: string){
    var t = theme();
    var traces: TrendTrace[] = [];
    [0,1,2].forEach(function(slot){
      var iso = highlighted[slot];
      if (!iso) return;
      var series = seriesAt(iso, metric);
      if (!series) return;
      const xs: number[] = [], ys: number[] = [];
      series.forEach(function(v,i){ if (v!==null && v!==undefined){ xs.push(YEARS[i]); ys.push(v); } });
      if (!xs.length) return;
      traces.push({
        type:"scatter", mode:"lines", name: COUNTRIES_BY_ISO[iso].name,
        x: xs, y: ys,
        line: { color: SERIES_COLORS_LIVE()[slot], width:2, shape:"spline", smoothing:0.3 },
        hovertemplate: "<b>"+COUNTRIES_BY_ISO[iso].name+"</b><br>%{x}: %{y" + (metric === "population" ? ":,.0f" : "") + "}<extra></extra>",
        showlegend:false
      });
    });

    var annotations: Partial<Annotations>[] = traces.map(function(tr){
      var lastX = tr.x[tr.x.length-1], lastY = tr.y[tr.y.length-1];
      return { x:lastX, y:lastY, text:tr.name, xanchor:"left", showarrow:false,
                font:{color:tr.line.color, size:10, family:theme().fontFamily}, xshift:6 };
    });
    separateEndLabels(annotations, traces, metric);

    var currentYear = YEARS[currentYearIdx];
    var shapes: Partial<Shape>[] = [{ type:"line", x0:currentYear, x1:currentYear, y0:0, y1:1, yref:"paper",
                    line:{ color:t.textMuted, width:1, dash:"dot" } }];

    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface, plot_bgcolor: t.surface,
      font: { color: t.textSecondary, family: t.fontFamily, size:10 },
      margin: { l:34, r:44, t:6, b:22 },
      xaxis: { gridcolor:"transparent", linecolor:t.axis, tickfont:{size:10}, tickvals:[YEARS[0], Math.round((YEARS[0] + YEARS[YEARS.length - 1]) / 2), YEARS[YEARS.length - 1]] },
      // "B" reads 1.4B for population where SI notation would print 1.4G.
      yaxis: { gridcolor:t.grid, zerolinecolor:t.axis, linecolor:"transparent", tickfont:{size:10}, exponentformat:"B" },
      shapes: shapes,
      annotations: annotations,
      showlegend:false
    };

    var elId = "sm-" + metric;
    if (document.getElementById(elId)){
      return Plotly.react(elId, traces, layout, {displayModeBar:false, responsive:true});
    }
  }

  // Countries that end on similar values (China and India on population) would
  // print their end labels on top of each other. Push labels apart vertically,
  // keeping each as close to its line's end as the minimum gap allows.
  function separateEndLabels(annotations: Partial<Annotations>[], traces: TrendTrace[], metric: string){
    if (annotations.length < 2) return;
    var el = document.getElementById("sm-" + metric);
    var plotHeight = Math.max(80, (el ? el.clientHeight : 230) - 28);
    var allY = traces.reduce(function(acc: number[], tr){ return acc.concat(tr.y); }, []);
    var min = Math.min(...allY), max = Math.max(...allY);
    var span = max - min || 1;
    var MIN_GAP = 13;
    var labels = annotations.map(function(a){
      var px = ((a.y as number) - min) / span * plotHeight;
      return { a: a, px: px, placed: px };
    }).sort(function(p, q){ return p.px - q.px; });
    for (var i = 1; i < labels.length; i++){
      labels[i].placed = Math.max(labels[i].placed, labels[i-1].placed + MIN_GAP);
    }
    // If pushing up ran past the top, slide the whole stack back down.
    var overflow = labels[labels.length-1].placed - plotHeight;
    if (overflow > 0){
      labels[labels.length-1].placed -= overflow;
      for (var j = labels.length - 2; j >= 0; j--){
        labels[j].placed = Math.min(labels[j].placed, labels[j+1].placed - MIN_GAP);
      }
    }
    labels.forEach(function(l){ l.a.yshift = Math.round(l.placed - l.px); });
  }

  function updateSmallMultipleMarkers(){
    var currentYear = YEARS[currentYearIdx];
    SM_METRICS.forEach(function(metric){
      var elId = "sm-" + metric;
      var el = document.getElementById(elId) as Partial<PlotlyHTMLElement> | null;
      if (!el || !el.data) return;
      Plotly.relayout(elId, {
        shapes: (el.layout?.shapes || []).map(shape => ({
          ...shape, x0: currentYear, x1: currentYear
        }))
      });
    });
  }

  // ---------- Comparison table ----------
  var TABLE_METRICS = ["co2_per_capita","co2","share_global_co2","gdp_per_capita","renewables_share_energy","population"];

  var TREND_PATHS = {
    up: "M10 15.5V4.5M5.5 9 10 4.5 14.5 9",
    down: "M10 4.5v11M5.5 11 10 15.5 14.5 11"
  };

  // Which direction helps the planet. GDP and population have no clear
  // planetary reading, so their arrows stay neutral.
  var PLANET_BETTER_WHEN: Record<string, "up" | "down"> = {
    co2_per_capita: "down",
    co2: "down",
    share_global_co2: "down",
    renewables_share_energy: "up"
  };

  // Direction measured against the previous year.
  function trendMark(iso: string, metric: string, value: number | null){
    var prev = currentYearIdx > 0 ? valueAt(iso, metric, currentYearIdx - 1) : null;
    if (value === null || value === undefined || prev === null || prev === undefined || isNaN(value) || isNaN(prev) || value === prev){
      return '<span class="trend" aria-hidden="true"></span>';
    }
    var dir: "up" | "down" = value > prev ? "up" : "down";
    var change = prev !== 0 ? Math.abs((value - prev) / prev * 100) : null;
    var detail = (dir === "up" ? "Up" : "Down") + (change !== null ? " " + (change < 0.1 ? "under 0.1" : change.toFixed(1)) + "%" : "") + " from " + YEARS[currentYearIdx - 1];
    var better = PLANET_BETTER_WHEN[metric];
    var impact = better ? (dir === better ? "good" : "bad") : "";
    if (impact) detail += impact === "good" ? ", better for the planet" : ", worse for the planet";
    return '<span class="trend' + (impact ? " trend-" + impact : "") + '" title="' + detail + '">' +
      '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="' + TREND_PATHS[dir] + '" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
      '<span class="sr-only">' + detail + '</span></span>';
  }

  function updateCompareTable(){
    var table = element("compareTable");
    var rows = highlighted.map(function(iso, slot){ return iso ? {iso:iso, slot:slot} : null; }).filter(row => row !== null);
    if (!rows.length){
      table.innerHTML = '';
      element("compareEmpty").hidden = false;
      table.hidden = true;
      return;
    }
    element("compareEmpty").hidden = true;
    table.hidden = false;
    var thead = "<thead><tr><th>Country</th>" + TABLE_METRICS.map(function(m){
      return "<th>" + DATA.metricMeta[m].label + "</th>";
    }).join("") + "</tr></thead>";
    var tbody = "<tbody>" + rows.map(function(r){
      var c = COUNTRIES_BY_ISO[r.iso];
      var cells = TABLE_METRICS.map(function(m){
        var v = valueAt(r.iso, m, currentYearIdx);
        return '<td><span class="metric-value">' + fmtValue(v, m) + trendMark(r.iso, m, v) + "</span></td>";
      }).join("");
      return '<tr><td class="country-cell"><span class="swatch" style="background:' + SERIES_COLORS_LIVE()[r.slot] + '"></span>' + c.name + '</td>' + cells + '</tr>';
    }).join("") + "</tbody>";
    table.innerHTML = thead + tbody;
  }

}

initAtlas();
</script>
