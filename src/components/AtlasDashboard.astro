---
import AtlasControls from './AtlasControls.astro';
import BackToTop from './BackToTop.astro';
import Hero from './Hero.astro';
import MetricSelect from './MetricSelect.astro';
import Panel from './Panel.astro';
import SoundToggle from './SoundToggle.astro';
---

  <Hero />
  <BackToTop />
  <SoundToggle />

  <div class="atlas-shell mx-auto max-w-[1280px] px-4 pt-20 pb-6 sm:px-6 lg:pt-28">
    <AtlasControls />

    <Panel id="nowComparing" title="The Comparison" description="A precise snapshot of every atlas metric for your selected countries and year. Arrows show the change from the year before: green is better for the planet, red is worse." class="snapshot-section">
      <div class="section-toolbar">
        <span>Selected year</span>
        <strong data-year-output>2024</strong>
      </div>
      <div class="table-frame">
        <p id="compareScrollHint" class="table-scroll-hint">Swipe sideways to see every metric. Country names stay pinned.</p>
        <div class="table-scroll overflow-x-auto">
          <table class="compare" id="compareTable" aria-label="Country metrics for the selected year" aria-describedby="compareScrollHint"></table>
        </div>
        <p id="compareEmpty" class="empty-note" hidden>Pick at least one country above.</p>
      </div>
    </Panel>

    <Panel id="worldMap" title="The World View" description="Move from a single value to the global pattern. Every country is held to one consistent scale across time." descriptionId="choroSub" class="map-section">
      <div class="map-layout grid gap-6 lg:grid-cols-[230px_minmax(0,1fr)] lg:items-stretch">
        <aside class="chart-sidebar flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5 lg:flex-col lg:flex-nowrap lg:items-stretch lg:justify-start lg:gap-8">
          <MetricSelect id="choroMetric" label="Map metric" />
          <fieldset class="map-view min-w-0 max-lg:order-2 max-lg:basis-full">
            <legend class="text-[11.5px] font-semibold tracking-[0.03em] text-muted uppercase">Map view</legend>
            <div class="segmented mt-1.5">
              <label><input type="radio" name="mapView" value="level" checked disabled />Level</label>
              <label><input type="radio" name="mapView" value="change" disabled />Change</label>
            </div>
          </fieldset>
          <div class="map-focus max-lg:order-3 max-lg:basis-full">
            <span class="block text-xs font-semibold text-muted">Your countries</span>
            <ol id="choroFocus" class="mt-3 grid gap-3 lg:gap-4"></ol>
          </div>
          <div class="lg:mt-auto">
            <span class="block text-xs font-semibold text-muted">Selected year</span>
            <strong class="mt-1 block font-mono text-3xl tabular-nums" data-year-output>2024</strong>
          </div>
        </aside>
        <div class="chart-stage min-w-0 rounded-xl border border-line bg-surface p-2 sm:p-4">
          <div id="choroplethChart" class="h-[210px] w-full sm:h-[360px] lg:h-[460px]" role="img" aria-label="World map of the selected metric"></div>
          <div id="choroLegend" class="map-legend"></div>
        </div>
      </div>
      <p id="choroCaption" class="mx-auto mt-5 max-w-[90ch] text-center text-[12.5px] leading-relaxed text-balance text-muted xl:max-w-none xl:whitespace-nowrap"></p>
    </Panel>

    <Panel id="rankings" title="The Rankings" description="The two ends of the same distribution, side by side: who leads, who trails, and who has travelled furthest since 1990." class="rankings-section">
      <div class="chart-toolbar mb-6 flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5">
        <div class="flex flex-1 flex-wrap gap-4">
          <MetricSelect id="rankMetric" label="Rank by" />
        </div>
        <div class="text-right">
          <span class="block text-xs font-semibold text-muted">Selected year</span>
          <strong class="mt-1 block font-mono text-2xl tabular-nums" data-year-output>2024</strong>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <section class="rank-card" aria-labelledby="rankTopTitle">
          <header class="rank-card-head">
            <h3 id="rankTopTitle" class="rank-card-title">Highest</h3>
            <p id="rankTopMeta" class="rank-card-meta"></p>
          </header>
          <ol id="rankTopList" class="rank-list"></ol>
            <p id="rankTopEmpty" class="empty-note" hidden></p>
        </section>
        <section class="rank-card" aria-labelledby="rankBottomTitle">
          <header class="rank-card-head">
            <h3 id="rankBottomTitle" class="rank-card-title">Lowest</h3>
            <p id="rankBottomMeta" class="rank-card-meta"></p>
          </header>
          <ol id="rankBottomList" class="rank-list"></ol>
            <p id="rankBottomEmpty" class="empty-note" hidden></p>
        </section>
      </div>

      <div class="rank-yours mt-4">
        <span class="block text-xs font-semibold text-muted">Where your countries rank</span>
        <ol id="rankYours" class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-3"></ol>
      </div>

      <div class="mt-10">
        <div class="chart-toolbar mb-4 flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5">
          <div class="min-w-0 flex-1">
            <h3 class="text-[15px] font-semibold">Biggest movers since 1990</h3>
            <p id="rankMoveSub" class="mt-1 max-w-[56ch] text-[12.5px] leading-relaxed text-muted"></p>
          </div>
          <fieldset class="min-w-0 max-sm:basis-full">
            <legend class="text-[11.5px] font-semibold tracking-[0.03em] text-muted uppercase">Measure by</legend>
            <div class="segmented mt-1.5">
              <label><input type="radio" name="rankBasis" value="pct" checked disabled />Percent</label>
              <label><input type="radio" name="rankBasis" value="abs" disabled /><span id="rankBasisAmount">Amount</span></label>
            </div>
          </fieldset>
        </div>
        <div id="rankMoversPair" class="grid gap-4 lg:grid-cols-2">
          <section class="rank-card" aria-labelledby="rankRiseTitle">
            <header class="rank-card-head">
              <h3 id="rankRiseTitle" class="rank-card-title">Biggest rises</h3>
              <p id="rankRiseMeta" class="rank-card-meta"></p>
            </header>
            <ol id="rankRiseList" class="rank-list"></ol>
            <p id="rankRiseEmpty" class="empty-note" hidden></p>
          </section>
          <section class="rank-card" aria-labelledby="rankFallTitle">
            <header class="rank-card-head">
              <h3 id="rankFallTitle" class="rank-card-title">Biggest falls</h3>
              <p id="rankFallMeta" class="rank-card-meta"></p>
            </header>
            <ol id="rankFallList" class="rank-list"></ol>
            <p id="rankFallEmpty" class="empty-note" hidden></p>
          </section>
        </div>
        <p id="rankMoveEmpty" class="empty-note" hidden></p>
      </div>

      <p id="rankCaption" class="mx-auto mt-6 max-w-[1040px] text-center text-[12.5px] leading-relaxed text-balance text-muted"></p>
    </Panel>

    <Panel id="relationship" title="GDP, Emissions and Population" singleLine description="Each bubble is a country and its area represents population. Change either axis to test a different relationship." class="relationship-section">
      <div class="chart-toolbar mb-6 flex flex-wrap items-end justify-between gap-5 rounded-xl bg-field p-5">
        <div class="flex flex-1 flex-wrap gap-4">
          <MetricSelect id="scatterX" label="Horizontal axis" />
          <MetricSelect id="scatterY" label="Vertical axis" />
        </div>
        <div class="text-right">
          <span class="block text-xs font-semibold text-muted">Selected year</span>
          <strong class="mt-1 block font-mono text-2xl tabular-nums" data-year-output>2024</strong>
        </div>
      </div>
      <div class="chart-stage min-w-0 rounded-xl border border-line bg-surface p-2 sm:p-4">
        <div id="scatterChart" class="h-[500px] w-full sm:h-[620px]" aria-label="Country metric and population comparison"></div>
      </div>
    </Panel>

    <Panel id="trends" title="The Trends Side by Side" description="Read the complete 1990–2024 record for the same countries. The dashed marker keeps your selected year visible across every metric." class="trends-section">
      <div class="section-toolbar mb-6">
        <span>Cross-chart marker</span>
        <strong data-year-output>2024</strong>
      </div>
      <div id="smGrid" class="trend-grid grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
    </Panel>

    <footer class="mx-auto mt-12 max-w-[1000px] border-t border-line pt-8 text-[12.5px] leading-[1.7] text-muted">
      <p>
      Data: <a class="text-secondary underline" href="https://github.com/owid/co2-data" target="_blank" rel="noopener">Our World in Data – CO₂ and Greenhouse Gas Emissions</a> and{' '}
      <a class="text-secondary underline" href="https://github.com/owid/energy-data" target="_blank" rel="noopener">Our World in Data – Energy</a>, and{' '}
      <a class="text-secondary underline" href="https://ourworldindata.org/grapher/gdp-per-capita-worldbank" target="_blank" rel="noopener">World Bank – GDP per capita, PPP (constant 2021 international $)</a> via Our World in Data, all CC BY. Renewables-share data covers 79 countries with reliable energy-mix reporting; others show as no-data on the map and are omitted from that metric's comparisons.
      </p>
      <p class="mt-6 flex items-center justify-center gap-1 text-[13px] text-secondary">
        Made with
        <svg class="size-3.5 shrink-0 text-accent" viewBox="0 0 20 20" fill="currentColor" role="img" aria-label="love">
          <path d="M10 17.5s-6.5-3.9-6.5-8.6A3.7 3.7 0 0 1 10 6.6a3.7 3.7 0 0 1 6.5 2.3c0 4.7-6.5 8.6-6.5 8.6Z" />
        </svg>
        by <a class="text-ink underline decoration-accent underline-offset-4" href="https://github.com/NHasan143" target="_blank" rel="noopener noreferrer">Naymul Hasan</a>
      </p>
    </footer>
  </div>

<script>
import type { Data, Layout, Shape, Annotations, ScatterLine, PlotlyHTMLElement } from 'plotly.js';

interface Country { iso3: string; name: string; continent: string; }
interface AtlasData {
  years: number[];
  countries: Country[];
  metrics: Record<string, Record<string, (number | null)[]>>;
  metricMeta: Record<string, { label: string; unit: string; vmax: number }>;
}
interface Bubble { x: number; y: number; size: number; text: string; }
interface TrendTrace {
  type: 'scatter';
  mode: 'lines';
  name: string;
  x: number[];
  y: number[];
  line: Partial<ScatterLine> & { color: string };
  hovertemplate: string;
  showlegend: boolean;
}

function element<T extends HTMLElement = HTMLElement>(id: string): T {
  const node = document.getElementById(id);
  if (!node) throw new Error(`Missing atlas element: ${id}`);
  return node as T;
}

function initAtlas(){
  let Plotly: typeof import('plotly.js');

  let DATA: AtlasData;
  let YEARS: number[] = [];
  const COUNTRIES_BY_ISO: Record<string, Country> = {};
  let COUNTRIES_SORTED: Country[] = [];
  // ISO codes that have a shape in world_110m.json. Plotly's hover throws on
  // any location it cannot draw, so every map layer lists only these.
  let MAP_ISOS = new Set<string>();
  let MAP_COUNTRIES: Country[] = [];
  var currentYearIdx = 0;
  var highlighted = ["USA","CHN","IND"]; // slot order = series 1/2/3
  var choroMetric = "co2_per_capita";
  var scatterXMetric = "gdp_per_capita";
  var scatterYMetric = "co2_per_capita";
  var maxPopulation = 1;
  let playTimer: ReturnType<typeof setInterval> | null = null;

  function getVar(name: string){
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  function theme(){
    return {
      surface: getVar("--surface"),
      surface2: getVar("--surface-2"),
      text: getVar("--text-primary"),
      textSecondary: getVar("--text-secondary"),
      textMuted: getVar("--text-muted"),
      grid: getVar("--grid"),
      axis: getVar("--axis"),
      border: getVar("--border"),
      context: getVar("--context-dot"),
      seq: [getVar("--seq-100"),getVar("--seq-200"),getVar("--seq-300"),getVar("--seq-400"),getVar("--seq-500"),getVar("--seq-600"),getVar("--seq-700")],
      series: [getVar("--accent"), getVar("--accent-2"), getVar("--accent-3")],
      fontFamily: "IBM Plex Sans, system-ui, sans-serif"
    };
  }

  function fmtValue(v: number | null | undefined, metric: string){
    if (v === null || v === undefined || isNaN(v)) return "—";
    if (metric === "co2_per_capita") return v.toFixed(2) + " t";
    if (metric === "co2") return v.toLocaleString(undefined,{maximumFractionDigits:0}) + " Mt";
    if (metric === "share_global_co2") return v.toFixed(2) + "%";
    if (metric === "gdp_per_capita") return "$" + v.toLocaleString(undefined,{maximumFractionDigits:0});
    if (metric === "renewables_share_energy") return v.toFixed(1) + "%";
    if (metric === "population") return v.toLocaleString(undefined,{maximumFractionDigits:0});
    return String(v);
  }

  function metricLabel(metric: string){
    var m = DATA.metricMeta[metric];
    return m ? (m.label + " (" + m.unit + ")") : metric;
  }

  function seriesAt(iso: string, metric: string){
    var m = DATA.metrics[metric];
    return m ? (m[iso] || null) : null;
  }

  function valueAt(iso: string, metric: string, yearIdx: number){
    var s = seriesAt(iso, metric);
    return s ? s[yearIdx] : null;
  }

  function axisType(metric: string){
    return (metric === "gdp_per_capita" || metric === "population") ? "log" : "linear";
  }

  // ---------- bootstrap ----------
  function setControlsEnabled(enabled: boolean){
    document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>("#controlsPanel button, #controlsPanel input, #controlsPanel select, #choroMetric, input[name=mapView], #scatterX, #scatterY, #rankMetric, input[name=rankBasis]").forEach(function(control){
      control.disabled = !enabled;
    });
  }

  setControlsEnabled(false);
  const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  Promise.all([
    import("plotly.js-dist-min").then(function(module){
      Plotly = module.default;
    }).catch(function(){
      throw new Error("The chart library could not load. Reload the atlas to try again.");
    }),
    // Same file Plotly draws from, so its own request is served from cache.
    fetch(assetBase + "world_110m.json").then(function(response){
      if (!response.ok) throw new Error("HTTP " + response.status);
      return response.json() as Promise<{ objects: { countries: { geometries: { id?: string }[] } } }>;
    }).then(function(topo){
      topo.objects.countries.geometries.forEach(function(g){ if (g.id) MAP_ISOS.add(g.id); });
    }).catch(function(){
      throw new Error("The map could not load. Check your connection and reload the atlas.");
    }),
    fetch(assetBase + "dataset.json").then(function(response){
      if (!response.ok) throw new Error("HTTP " + response.status);
      return response.json() as Promise<AtlasData>;
    }).catch(function(){
      throw new Error("The atlas data could not load. Check your connection and reload the atlas.");
    })
  ]).then(function([, , d]){
    DATA = d;
    YEARS = d.years;
    d.countries.forEach(function(c){ COUNTRIES_BY_ISO[c.iso3] = c; });
    COUNTRIES_SORTED = d.countries.slice().sort(function(a,b){ return a.name.localeCompare(b.name); });
    MAP_COUNTRIES = COUNTRIES_SORTED.filter(function(c){ return MAP_ISOS.has(c.iso3); });

    Object.keys(d.metrics).forEach(function(metric){
      Object.keys(d.metrics[metric]).forEach(function(iso){
        d.metrics[metric][iso].forEach(function(v){
          if (metric === "population" && v && v > maxPopulation) maxPopulation = v;
        });
      });
    });

    currentYearIdx = YEARS.length - 1;
    element<HTMLInputElement>("yearSlider").max = String(YEARS.length - 1);
    element<HTMLInputElement>("yearSlider").value = String(currentYearIdx);
    element("yearReadout").textContent = String(YEARS[currentYearIdx]);

    buildMetricDropdown(element<HTMLSelectElement>("choroMetric"), choroMetric);
    buildMetricDropdown(element<HTMLSelectElement>("scatterX"), scatterXMetric);
    buildMetricDropdown(element<HTMLSelectElement>("scatterY"), scatterYMetric);
    buildMetricDropdown(element<HTMLSelectElement>("rankMetric"), rankMetric);
    buildCountryPickers();

    updateCompareTable();
    syncRankBasisControl();
    updateRankings(false);
    return Promise.all([renderChoropleth(), renderScatter(), renderSmallMultiples()]);
  }).then(function(){
    wireEvents();
    setControlsEnabled(true);
    element("loadStatus").hidden = true;
  }).catch(function(error){
    console.error("Atlas initialization failed:", error);
    setControlsEnabled(false);
    var status = element("loadStatus");
    status.textContent = error.message;
    status.hidden = false;
    element("loadRetry").hidden = false;
  });

  function buildMetricDropdown(sel: HTMLSelectElement, selected: string){
    sel.innerHTML = "";
    Object.keys(DATA.metricMeta).forEach(function(key){
      var opt = document.createElement("option");
      opt.value = key;
      opt.textContent = DATA.metricMeta[key].label;
      if (key === selected) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  // ---------- country search ----------
  // A native <select> over 217 countries buries everything past the first
  // screenful. These are ARIA comboboxes: type to filter, arrows to browse.

  // Short names people actually type. The dataset carries one formal name per
  // country, so "UK", "Holland" and "Ivory Coast" would otherwise find nothing.
  const COUNTRY_ALIASES: Record<string, string[]> = {
    USA: ["us", "usa", "america", "united states of america"],
    GBR: ["uk", "britain", "great britain", "england", "scotland", "wales", "northern ireland"],
    ARE: ["uae", "emirates"],
    NLD: ["holland"],
    CIV: ["ivory coast"],
    CZE: ["czech republic"],
    COD: ["drc", "congo kinshasa", "zaire"],
    COG: ["congo brazzaville", "republic of congo"],
    MMR: ["burma"],
    SWZ: ["swaziland"],
    TLS: ["timor leste"],
    MKD: ["macedonia"],
    TUR: ["turkiye"],
    CPV: ["cabo verde"],
    KNA: ["st kitts and nevis"],
    LCA: ["st lucia"],
    VCT: ["st vincent and the grenadines"],
    STP: ["sao tome"],
    CHE: ["swiss"],
    DEU: ["germany deutschland"],
  };

  interface CountryEntry {
    c: Country;
    norm: string;      // lowercased, unaccented, punctuation flattened to spaces
    words: string[];
    iso: string;
    aliases: string[];
    fold: string;      // lenient fold, mapped back to positions in c.name
    foldMap: number[];
  }
  let COUNTRY_INDEX: CountryEntry[] = [];
  const CONTINENTS: string[] = [];
  const SLOT_LABELS = ["Country 1", "Country 2", "Country 3"];

  function normalizeQuery(s: string){
    return s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, " ").trim();
  }

  // Folds accents away while remembering which source character each folded
  // character came from, so the matched run can be marked in the real name.
  function foldAligned(name: string){
    var fold = "";
    var map: number[] = [];
    for (var i = 0; i < name.length; i++){
      var f = name.charAt(i).normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
      for (var j = 0; j < f.length; j++){ fold += f.charAt(j); map.push(i); }
    }
    map.push(name.length);
    return { fold: fold, map: map };
  }

  function buildCountryIndex(){
    COUNTRY_INDEX = COUNTRIES_SORTED.map(function(c){
      var norm = normalizeQuery(c.name);
      var aligned = foldAligned(c.name);
      return {
        c: c,
        norm: norm,
        words: norm.split(" ").filter(Boolean),
        iso: c.iso3.toLowerCase(),
        aliases: (COUNTRY_ALIASES[c.iso3] || []).map(normalizeQuery),
        fold: aligned.fold,
        foldMap: aligned.map
      };
    });
    COUNTRIES_SORTED.forEach(function(c){
      if (CONTINENTS.indexOf(c.continent) === -1) CONTINENTS.push(c.continent);
    });
    CONTINENTS.sort();
  }

  // Lower rank sorts first. null means no match at all.
  function rankEntry(entry: CountryEntry, q: string): number | null {
    if (entry.iso === q) return 0;
    if (entry.norm === q) return 1;
    if (entry.norm.indexOf(q) === 0) return 2;
    if (entry.iso.indexOf(q) === 0) return 3;
    for (var i = 0; i < entry.words.length; i++){
      if (entry.words[i].indexOf(q) === 0) return 4;
    }
    for (var a = 0; a < entry.aliases.length; a++){
      if (entry.aliases[a].indexOf(q) === 0) return 5;
    }
    if (entry.norm.indexOf(q) > -1) return 6;
    for (var b = 0; b < entry.aliases.length; b++){
      if (entry.aliases[b].indexOf(q) > -1) return 7;
    }
    return null;
  }

  function searchCountries(raw: string){
    var q = normalizeQuery(raw);
    if (!q) return COUNTRY_INDEX.slice();
    var hits: { entry: CountryEntry; rank: number }[] = [];
    COUNTRY_INDEX.forEach(function(entry){
      var rank = rankEntry(entry, q);
      if (rank !== null) hits.push({ entry: entry, rank: rank });
    });
    hits.sort(function(a, b){
      return a.rank - b.rank || a.entry.c.name.localeCompare(b.entry.c.name);
    });
    return hits.map(function(h){ return h.entry; });
  }

  // Marks the matched run inside the real name. Builds text nodes rather than
  // markup, so a country name is never parsed as HTML.
  function labelWithMatch(entry: CountryEntry, raw: string){
    var frag = document.createDocumentFragment();
    var name = entry.c.name;
    var q = "";
    for (var i = 0; i < raw.length; i++){
      q += raw.charAt(i).normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    }
    q = q.trim();
    var at = q ? entry.fold.indexOf(q) : -1;
    if (at < 0){
      frag.appendChild(document.createTextNode(name));
      return frag;
    }
    var start = entry.foldMap[at];
    var end = entry.foldMap[at + q.length];
    frag.appendChild(document.createTextNode(name.slice(0, start)));
    var mark = document.createElement("mark");
    mark.textContent = name.slice(start, end);
    frag.appendChild(mark);
    frag.appendChild(document.createTextNode(name.slice(end)));
    return frag;
  }

  function checkIcon(){
    var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("class", "combo-check");
    svg.setAttribute("viewBox", "0 0 16 16");
    svg.setAttribute("fill", "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "2");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");
    svg.setAttribute("aria-hidden", "true");
    var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", "m3 8.5 3.2 3.2L13 5");
    svg.appendChild(path);
    return svg;
  }

  interface CountryPicker {
    setSelected(iso: string): void;
  }

  function createCountryPicker(slot: number): CountryPicker {
    const input = element<HTMLInputElement>("cmp" + slot);
    const pop = element("cmp" + slot + "Pop");
    const listbox = element("cmp" + slot + "List");
    const emptyNote = element("cmp" + slot + "Empty");
    const clearBtn = element<HTMLButtonElement>("cmp" + slot + "Clear");
    const status = element("cmp" + slot + "Status");
    const combo = input.closest(".combo") as HTMLElement;

    var isOpen = false;
    var results: CountryEntry[] = [];
    var activeIdx = -1;
    var statusTimer: ReturnType<typeof setTimeout> | null = null;

    function optionId(iso: string){ return "cmp" + slot + "-opt-" + iso; }

    function announce(message: string, delay: number){
      if (statusTimer) clearTimeout(statusTimer);
      statusTimer = setTimeout(function(){ status.textContent = message; }, delay);
    }

    function renderOption(entry: CountryEntry, raw: string){
      var option = document.createElement("div");
      option.className = "combo-option";
      option.id = optionId(entry.c.iso3);
      option.setAttribute("role", "option");
      option.dataset.iso = entry.c.iso3;
      option.setAttribute("aria-selected", String(highlighted[slot] === entry.c.iso3));

      var name = document.createElement("span");
      name.className = "combo-name";
      name.appendChild(labelWithMatch(entry, raw));
      option.appendChild(name);

      var otherSlot = -1;
      for (var s = 0; s < 3; s++){
        if (s !== slot && highlighted[s] === entry.c.iso3) otherSlot = s;
      }
      if (highlighted[slot] === entry.c.iso3){
        option.appendChild(checkIcon());
      } else if (otherSlot > -1){
        // Choosing it here empties the other slot, so say so before the click.
        var tag = document.createElement("span");
        tag.className = "combo-tag";
        var swatch = document.createElement("span");
        swatch.className = "swatch";
        swatch.style.background = SERIES_COLORS_LIVE()[otherSlot];
        tag.appendChild(swatch);
        tag.appendChild(document.createTextNode("In " + SLOT_LABELS[otherSlot].toLowerCase()));
        option.appendChild(tag);
      }
      return option;
    }

    function render(raw: string){
      results = searchCountries(raw);
      activeIdx = -1;
      listbox.textContent = "";

      if (!results.length){
        emptyNote.textContent = "No country matches “" + raw.trim() + "”. Try a shorter spelling or a three-letter code.";
        emptyNote.hidden = false;
        input.removeAttribute("aria-activedescendant");
        announce("No countries found.", 400);
        return;
      }
      emptyNote.hidden = true;

      var frag = document.createDocumentFragment();
      if (!normalizeQuery(raw)){
        // Unfiltered, continent grouping is the only structure worth keeping.
        CONTINENTS.forEach(function(continent){
          var members = results.filter(function(e){ return e.c.continent === continent; });
          if (!members.length) return;
          var group = document.createElement("div");
          group.setAttribute("role", "group");
          group.setAttribute("aria-label", continent);
          var label = document.createElement("div");
          label.className = "combo-group-label";
          label.setAttribute("aria-hidden", "true");
          label.textContent = continent;
          group.appendChild(label);
          members.forEach(function(entry){ group.appendChild(renderOption(entry, "")); });
          frag.appendChild(group);
        });
        // Grouping reorders the flat list, so mirror it back for arrow keys.
        results = CONTINENTS.reduce(function(acc: CountryEntry[], continent){
          return acc.concat(results.filter(function(e){ return e.c.continent === continent; }));
        }, []);
      } else {
        results.forEach(function(entry){
          var option = renderOption(entry, raw);
          var place = document.createElement("span");
          place.className = "combo-tag";
          if (!option.querySelector(".combo-tag") && !option.querySelector(".combo-check")){
            place.textContent = entry.c.continent;
            option.appendChild(place);
          }
          frag.appendChild(option);
        });
        announce(results.length === 1
          ? "1 country found: " + results[0].c.name + "."
          : results.length + " countries found. " + results[0].c.name + " is first.", 400);
      }
      listbox.appendChild(frag);
      if (normalizeQuery(raw)) setActive(0);
      else {
        // Opening on the current pick: centre it, so the names either side of
        // it are visible instead of the list landing on its last row.
        var selectedIdx = results.findIndex(function(e){ return e.c.iso3 === highlighted[slot]; });
        if (selectedIdx > -1) setActive(selectedIdx, "center");
      }
    }

    function setActive(index: number, block: ScrollLogicalPosition = "nearest"){
      var previous = listbox.querySelector<HTMLElement>('[data-active="true"]');
      if (previous) previous.removeAttribute("data-active");
      activeIdx = index;
      if (index < 0 || !results[index]){
        input.removeAttribute("aria-activedescendant");
        return;
      }
      var id = optionId(results[index].c.iso3);
      var option = document.getElementById(id);
      if (!option) return;
      option.dataset.active = "true";
      input.setAttribute("aria-activedescendant", id);
      revealOption(option, block === "center");
    }

    // scrollIntoView would scroll the page as well as the list. This moves only
    // the list, and keeps the sticky continent heading clear of the active row.
    function revealOption(option: HTMLElement, center: boolean){
      var listRect = listbox.getBoundingClientRect();
      var optionRect = option.getBoundingClientRect();
      if (center){
        listbox.scrollTop += (optionRect.top - listRect.top) - (listRect.height - optionRect.height) / 2;
        return;
      }
      var heading = listbox.querySelector<HTMLElement>(".combo-group-label");
      var inset = heading ? heading.offsetHeight : 0;
      if (optionRect.top - inset < listRect.top) listbox.scrollTop += optionRect.top - inset - listRect.top;
      else if (optionRect.bottom > listRect.bottom) listbox.scrollTop += optionRect.bottom - listRect.bottom;
    }

    function move(delta: number){
      if (!results.length) return;
      var next = activeIdx + delta;
      if (next < 0) next = results.length - 1;
      if (next >= results.length) next = 0;
      setActive(next);
    }

    function place(){
      var rect = input.getBoundingClientRect();
      var below = window.innerHeight - rect.bottom - 16;
      var above = rect.top - 16;
      var flip = below < 200 && above > below;
      if (flip) pop.dataset.placement = "top";
      else delete pop.dataset.placement;
      var room = Math.max(160, Math.min(304, flip ? above : below));
      listbox.style.maxHeight = room + "px";
    }

    function openList(){
      if (isOpen || input.disabled) return;
      isOpen = true;
      pop.hidden = false;
      input.setAttribute("aria-expanded", "true");
      place();
      render(input.value === selectedName() ? "" : input.value);
    }

    function closeList(){
      if (!isOpen) return;
      isOpen = false;
      pop.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIdx = -1;
      if (statusTimer) clearTimeout(statusTimer);
    }

    function selectedName(){
      var iso = highlighted[slot];
      return iso && COUNTRIES_BY_ISO[iso] ? COUNTRIES_BY_ISO[iso].name : "";
    }

    function syncInput(){
      input.value = selectedName();
      clearBtn.hidden = !input.value;
    }

    function commit(iso: string){
      var displaced = -1;
      for (var other = 0; other < 3; other++){
        if (other !== slot && highlighted[other] === iso && iso !== ""){
          displaced = other;
          highlighted[other] = "";
          PICKERS[other].setSelected("");
        }
      }
      highlighted[slot] = iso;
      syncInput();
      closeList();

      if (statusTimer) clearTimeout(statusTimer);
      status.textContent = iso
        ? COUNTRIES_BY_ISO[iso].name + " selected for " + SLOT_LABELS[slot] + "."
          + (displaced > -1 ? " " + SLOT_LABELS[displaced] + " is now empty." : "")
        : SLOT_LABELS[slot] + " cleared.";

      renderChoropleth();
      renderScatter();
      renderSmallMultiples();
      updateCompareTable();
      updateRankings(true);
    }

    input.addEventListener("focus", function(){
      input.select();
      openList();
    });

    input.addEventListener("pointerdown", function(){
      if (document.activeElement === input) {
        if (isOpen) closeList(); else openList();
      }
    });

    input.addEventListener("input", function(){
      clearBtn.hidden = !input.value;
      if (!isOpen) openList();
      else { render(input.value); place(); }
    });

    input.addEventListener("keydown", function(event){
      if (event.key === "ArrowDown"){
        event.preventDefault();
        if (!isOpen) openList(); else move(1);
      } else if (event.key === "ArrowUp"){
        event.preventDefault();
        if (!isOpen){ openList(); setActive(results.length - 1); }
        else move(-1);
      } else if (event.key === "Enter"){
        if (isOpen && activeIdx > -1){
          event.preventDefault();
          commit(results[activeIdx].c.iso3);
        }
      } else if (event.key === "Escape"){
        if (isOpen){
          event.preventDefault();
          event.stopPropagation();
          closeList();
          syncInput();
        } else if (input.value){
          syncInput();
        }
      } else if (event.key === "Tab"){
        closeList();
        syncInput();
      }
    });

    // mousedown would blur the input first and close the list under the cursor.
    listbox.addEventListener("mousedown", function(event){ event.preventDefault(); });
    listbox.addEventListener("click", function(event){
      var option = (event.target as HTMLElement).closest<HTMLElement>(".combo-option");
      if (option && option.dataset.iso) commit(option.dataset.iso);
    });
    listbox.addEventListener("pointermove", function(event){
      var option = (event.target as HTMLElement).closest<HTMLElement>(".combo-option");
      if (!option || !option.dataset.iso) return;
      var iso = option.dataset.iso;
      var index = results.findIndex(function(e){ return e.c.iso3 === iso; });
      if (index > -1 && index !== activeIdx) setActive(index);
    });

    clearBtn.addEventListener("click", function(){
      commit("");
      input.focus();
    });

    combo.addEventListener("focusout", function(event){
      if (combo.contains(event.relatedTarget as Node)) return;
      closeList();
      syncInput();
    });

    window.addEventListener("resize", function(){ if (isOpen) place(); });

    return {
      setSelected: function(iso: string){
        highlighted[slot] = iso;
        syncInput();
      }
    };
  }

  const PICKERS: CountryPicker[] = [];

  function buildCountryPickers(){
    buildCountryIndex();
    [0,1,2].forEach(function(slot){ PICKERS.push(createCountryPicker(slot)); });
    [0,1,2].forEach(function(slot){ PICKERS[slot].setSelected(highlighted[slot] || ""); });
  }

  function wireEvents(){
    element<HTMLInputElement>("yearSlider").addEventListener("input", function(e){
      currentYearIdx = parseInt((e.currentTarget as HTMLInputElement | HTMLSelectElement).value, 10);
      onYearChange();
    });
    element("playBtn").addEventListener("click", togglePlay);
    element<HTMLSelectElement>("choroMetric").addEventListener("change", function(e){
      choroMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderChoropleth();
    });
    document.querySelectorAll<HTMLInputElement>("input[name=mapView]").forEach(function(input){
      input.checked = input.value === mapView;
      input.addEventListener("change", function(){ if (input.checked) setMapView(input.value as MapView); });
    });
    element<HTMLSelectElement>("scatterX").addEventListener("change", function(e){
      scatterXMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderScatter();
    });
    element<HTMLSelectElement>("scatterY").addEventListener("change", function(e){
      scatterYMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      renderScatter();
    });
    element<HTMLSelectElement>("rankMetric").addEventListener("change", function(e){
      rankMetric = (e.currentTarget as HTMLInputElement | HTMLSelectElement).value;
      syncRankBasisControl();
      updateRankings(true);
    });
    document.querySelectorAll<HTMLInputElement>("input[name=rankBasis]").forEach(function(input){
      input.addEventListener("change", function(){
        if (!input.checked) return;
        rankBasis = input.value as MoverBasis;
        updateRankings(true);
      });
    });
    // Country slots wire themselves up in createCountryPicker.

    if (rankWidth.addEventListener) rankWidth.addEventListener("change", function(){ updateRankings(false); });

    var mq = window.matchMedia("(prefers-color-scheme: dark)");
    if (mq.addEventListener) mq.addEventListener("change", reTheme);
    new MutationObserver(reTheme).observe(document.documentElement, {attributes:true, attributeFilter:["data-theme"]});
  }

  function reTheme(){
    renderChoropleth();
    renderScatter();
    renderSmallMultiples();
    updateRankings(false);
  }

  function setPlayState(playing: boolean){
    element("playLabel").textContent = playing ? "Pause" : "Play";
    element("playIcon").style.display = playing ? "none" : "block";
    element("pauseIcon").style.display = playing ? "block" : "none";
    element("playBtn").setAttribute("aria-pressed", String(playing));
    // Pressing Play is the gesture a browser requires before it will let any
    // audio start, so the sound control listens for this rather than guessing.
    document.dispatchEvent(new CustomEvent("atlas:playback", { detail: { playing: playing } }));
  }

  function updateYearOutputs(){
    document.querySelectorAll<HTMLElement>("[data-year-output]").forEach(function(output){
      output.textContent = String(YEARS[currentYearIdx]);
    });
  }

  function stopPlayback(){
    if (playTimer) clearInterval(playTimer);
    playTimer = null;
    setPlayState(false);
    element("playBtn").setAttribute("aria-label", "Play animation");
  }

  function setYear(idx: number){
    currentYearIdx = idx;
    element<HTMLInputElement>("yearSlider").value = String(currentYearIdx);
    onYearChange();
  }

  // Play runs a single pass up to the latest year, then stops. Starting from
  // the latest year rewinds to the first so the pass covers the full record.
  function togglePlay(){
    if (playTimer){
      stopPlayback();
      return;
    }
    var lastIdx = YEARS.length - 1;
    if (currentYearIdx >= lastIdx) setYear(0);
    setPlayState(true);
    element("playBtn").setAttribute("aria-label", "Pause animation");
    playTimer = setInterval(function(){
      setYear(Math.min(currentYearIdx + 1, lastIdx));
      if (currentYearIdx >= lastIdx) stopPlayback();
    }, 650);
  }

  function onYearChange(){
    element("yearReadout").textContent = String(YEARS[currentYearIdx]);
    updateYearOutputs();
    updateChoroplethYear();
    updateScatterYear();
    updateSmallMultipleMarkers();
    updateCompareTable();
    updateRankings(true);
  }

  // ---------- Rankings ----------
  // Four ranked lists in two pairs. Each pair shares one scale, so the gap
  // between the top of one list and the top of the other is real rather than
  // an artefact of scaling each list to its own maximum.
  type MoverBasis = "pct" | "abs";
  var rankMetric = "co2_per_capita";
  var rankBasis: MoverBasis = "pct";
  // Ten rows a list reads well beside its pair on a wide screen. Stacked on a
  // phone the same four lists add nearly 1,300px of scroll, so the phone gets
  // five; the rank numbers and the reporting count keep that honest.
  const RANK_ROWS_WIDE = 10;
  const RANK_ROWS_NARROW = 5;
  var rankWidth = window.matchMedia("(min-width: 640px)");
  function rankRows(){ return rankWidth.matches ? RANK_ROWS_WIDE : RANK_ROWS_NARROW; }
  // A country that reports a near-zero figure still gets a visible sliver, so
  // it never reads as the grey of no data.
  const RANK_FLOOR = 0.008;

  interface RankEntry { iso: string; name: string; value: number; rank: number; }
  interface MoverEntry { iso: string; name: string; delta: number; }
  interface RankRow { iso: string; name: string; rank: string; value: string; ratio: number; fill: string; }
  var EXIT_MS = 320;

  function isShareMetric(metric: string){
    return CHANGE_BANDS[metric].mode === "pts";
  }

  // fmtValue rounds for the comparison table, where a rounded zero is fine.
  // In a ranked list the smallest reporters are the content, so carry enough
  // digits that they never all read as the same flat zero.
  function fmtRankValue(v: number, metric: string){
    var base = fmtValue(v, metric);
    if (v <= 0 || /[1-9]/.test(base)) return base;
    if (metric === "gdp_per_capita") return "$" + Number(v.toPrecision(2));
    if (metric === "population") return String(Math.round(v));
    var unit = metric === "co2" ? " Mt" : metric === "co2_per_capita" ? " t" : "%";
    return Number(v.toPrecision(2)) + unit;
  }

  function fmtAmount(delta: number, metric: string){
    var sign = delta > 0 ? "+" : delta < 0 ? "−" : "";
    if (isShareMetric(metric)) return fmtChange(delta, CHANGE_BANDS[metric], metric);
    return sign + fmtValue(Math.abs(delta), metric);
  }

  function fmtMover(delta: number, metric: string){
    return rankBasis === "pct" && !isShareMetric(metric)
      ? fmtChange(delta, PCT_CHANGE, metric)
      : fmtAmount(delta, metric);
  }

  function rankedFor(metric: string, yearIdx: number): RankEntry[] {
    var series = DATA.metrics[metric];
    if (!series) return [];
    var rows: { iso: string; name: string; value: number }[] = [];
    Object.keys(series).forEach(function(iso){
      var country = COUNTRIES_BY_ISO[iso];
      var v = series[iso][yearIdx];
      if (country && hasNumber(v)) rows.push({ iso: iso, name: country.name, value: v });
    });
    rows.sort(function(a, b){ return b.value - a.value || a.name.localeCompare(b.name); });
    // Competition ranking: countries reporting the same figure share a rank.
    var ranked: RankEntry[] = [];
    rows.forEach(function(row, i){
      var rank = i > 0 && row.value === rows[i - 1].value ? ranked[i - 1].rank : i + 1;
      ranked.push({ iso: row.iso, name: row.name, value: row.value, rank: rank });
    });
    return ranked;
  }

  function moversFor(metric: string, yearIdx: number): MoverEntry[] {
    var series = DATA.metrics[metric];
    if (!series || yearIdx === 0) return [];
    var relative = rankBasis === "pct" && !isShareMetric(metric);
    var out: MoverEntry[] = [];
    Object.keys(series).forEach(function(iso){
      var country = COUNTRIES_BY_ISO[iso];
      if (!country) return;
      var from = series[iso][0];
      var to = series[iso][yearIdx];
      if (!hasNumber(from) || !hasNumber(to)) return;
      // A percent change off a zero baseline is not a number, so those
      // countries drop out of the relative list rather than reading infinite.
      if (relative && from === 0) return;
      out.push({ iso: iso, name: country.name, delta: relative ? (to - from) / from * 100 : to - from });
    });
    out.sort(function(a, b){ return b.delta - a.delta || a.name.localeCompare(b.name); });
    return out;
  }

  function levelBandColors(){
    var t = theme();
    return [t.seq[0], t.seq[1], t.seq[2], t.seq[3], t.seq[5], t.seq[6]];
  }

  function levelFill(value: number, colors: string[]){
    return colors[bandIndex(LEVEL_BANDS[rankMetric].edges, value)];
  }

  // Movers inherit the Change map's reading: green and red where the metric
  // has a planetary direction, neutral growth or decline where it does not.
  function moverFill(metric: string, delta: number){
    var better = PLANET_BETTER_WHEN[metric];
    var token = better
      ? ((delta > 0 ? "up" : "down") === better ? "--rank-good" : "--rank-bad")
      : (delta > 0 ? "--rank-growth" : "--rank-decline");
    return getVar(token);
  }

  function createRankRow(key: string){
    var li = document.createElement("li");
    li.className = "rank-row";
    li.dataset.key = key;
    li.dataset.enter = "true";
    var bar = document.createElement("i");
    bar.className = "rank-bar";
    bar.setAttribute("aria-hidden", "true");
    var fill = document.createElement("i");
    fill.className = "rank-fill";
    bar.appendChild(fill);
    var num = document.createElement("span");
    num.className = "rank-num";
    var name = document.createElement("span");
    name.className = "rank-name";
    var swatch = document.createElement("span");
    swatch.className = "swatch";
    var label = document.createElement("span");
    label.className = "rank-label";
    name.appendChild(swatch);
    name.appendChild(label);
    var value = document.createElement("span");
    value.className = "rank-value";
    li.appendChild(bar);
    li.appendChild(num);
    li.appendChild(name);
    li.appendChild(value);
    return li;
  }

  function updateRankRow(li: HTMLElement, row: RankRow){
    var slot = highlighted.indexOf(row.iso);
    li.style.setProperty("--rank-fill", row.fill);
    (li.querySelector(".rank-fill") as HTMLElement).style.transform =
      "scaleX(" + (row.ratio > 0 ? Math.max(row.ratio, RANK_FLOOR) : 0).toFixed(4) + ")";
    li.querySelector(".rank-num")!.textContent = row.rank;
    li.querySelector(".rank-label")!.textContent = row.name;
    li.querySelector(".rank-value")!.textContent = row.value;
    var swatch = li.querySelector(".swatch") as HTMLElement;
    swatch.hidden = slot < 0;
    if (slot > -1){
      li.dataset.selected = "true";
      var mark = SERIES_COLORS_LIVE()[slot];
      li.style.setProperty("--rank-mark", mark);
      swatch.style.background = mark;
    } else {
      delete li.dataset.selected;
      li.style.removeProperty("--rank-mark");
    }
  }

  // Rows are reused rather than rebuilt, so a bar can transition its width and
  // a row that moves up the list can be measured before and after the move.
  function syncRankList(listId: string, rows: RankRow[], emptyText: string){
    var list = element(listId);
    var note = element(listId.replace("List", "Empty"));
    note.hidden = rows.length > 0;
    note.textContent = emptyText;
    const existing: Record<string, HTMLElement> = {};
    Array.prototype.forEach.call(list.children, function(child: HTMLElement){
      if (child.dataset.key) existing[child.dataset.key] = child;
    });
    const keep: Record<string, boolean> = {};
    rows.forEach(function(row){
      var key = listId + ":" + row.iso;
      keep[key] = true;
      var li = existing[key] || createRankRow(key);
      updateRankRow(li, row);
      list.appendChild(li);
    });
    Object.keys(existing).forEach(function(key){
      if (keep[key]) return;
      var leaving = existing[key];
      if (leaving.dataset.exit) return;
      // Pin it where it already sits, then let it fade without dragging the
      // rows that remain, which is what made a playing list look like flicker.
      leaving.style.top = leaving.offsetTop + "px";
      leaving.dataset.exit = "true";
      delete leaving.dataset.key;
      setTimeout(function(){ leaving.remove(); }, EXIT_MS);
    });
  }

  function levelRows(entries: RankEntry[], scale: number): RankRow[] {
    var colors = levelBandColors();
    return entries.map(function(entry){
      return {
        iso: entry.iso,
        name: entry.name,
        rank: String(entry.rank),
        value: fmtRankValue(entry.value, rankMetric),
        ratio: scale > 0 ? Math.max(entry.value, 0) / scale : 0,
        fill: levelFill(entry.value, colors)
      };
    });
  }

  function moverRows(entries: MoverEntry[], scale: number): RankRow[] {
    return entries.map(function(entry, i){
      return {
        iso: entry.iso,
        name: entry.name,
        rank: String(i + 1),
        value: fmtMover(entry.delta, rankMetric),
        ratio: scale > 0 ? Math.abs(entry.delta) / scale : 0,
        fill: moverFill(rankMetric, entry.delta)
      };
    });
  }

  function rankMoves(): Record<string, number> {
    const moves: Record<string, number> = {};
    var series = DATA.metrics[rankMetric];
    if (!series || currentYearIdx === 0) return moves;
    var both: { iso: string; then: number; now: number; name: string }[] = [];
    Object.keys(series).forEach(function(iso){
      var country = COUNTRIES_BY_ISO[iso];
      var then = series[iso][0];
      var now = series[iso][currentYearIdx];
      if (country && hasNumber(then) && hasNumber(now)){
        both.push({ iso: iso, then: then, now: now, name: country.name });
      }
    });
    const thenRank: Record<string, number> = {};
    both.slice().sort(function(a, b){ return b.then - a.then || a.name.localeCompare(b.name); })
      .forEach(function(row, i){ thenRank[row.iso] = i + 1; });
    both.slice().sort(function(a, b){ return b.now - a.now || a.name.localeCompare(b.name); })
      .forEach(function(row, i){ moves[row.iso] = thenRank[row.iso] - (i + 1); });
    return moves;
  }

  // Rebuilt from scratch this strip flashed three times a second under Play.
  // The cells are kept and only their text is rewritten.
  function updateRankYours(entries: RankEntry[]){
    var list = element("rankYours");
    var year = YEARS[currentYearIdx];
    var moves = rankMoves();
    var colors = SERIES_COLORS_LIVE();

    if (!highlighted.some(Boolean)){
      if (!list.querySelector(".rank-your-empty")){
        list.innerHTML = '<li class="rank-your-empty text-[12.5px] text-muted">Pick countries above to see where they stand.</li>';
      }
      return;
    }
    var emptyNote = list.querySelector(".rank-your-empty");
    if (emptyNote) emptyNote.remove();

    const existing: Record<string, HTMLElement> = {};
    Array.prototype.forEach.call(list.children, function(child: HTMLElement){
      if (child.dataset.slot) existing[child.dataset.slot] = child;
    });
    const keep: Record<string, boolean> = {};

    highlighted.forEach(function(iso, slot){
      if (!iso) return;
      var country = COUNTRIES_BY_ISO[iso];
      if (!country) return;
      keep[String(slot)] = true;
      var li = existing[String(slot)];
      if (!li){
        li = document.createElement("li");
        li.className = "rank-your-item";
        li.dataset.slot = String(slot);
        ["swatch", "rank-your-name", "rank-your-value", "rank-your-note"].forEach(function(cls){
          var span = document.createElement("span");
          span.className = cls;
          li.appendChild(span);
        });
      }
      var entry: RankEntry | null = null;
      for (var i = 0; i < entries.length; i++){
        if (entries[i].iso === iso){ entry = entries[i]; break; }
      }
      var move = moves[iso];
      var movePhrase = move === undefined ? ""
        : move === 0 ? " \u00b7 same place as in " + YEARS[0]
        : " \u00b7 " + (move > 0 ? "up " : "down ") + Math.abs(move)
          + " place" + (Math.abs(move) === 1 ? "" : "s") + " since " + YEARS[0];

      (li.querySelector(".swatch") as HTMLElement).style.background = colors[slot];
      li.querySelector(".rank-your-name")!.textContent = country.name;
      li.querySelector(".rank-your-value")!.textContent = entry ? fmtRankValue(entry.value, rankMetric) : "\u2014";
      li.querySelector(".rank-your-note")!.textContent = entry
        ? ordinal(entry.rank) + " highest of " + entries.length + movePhrase
        : "No data for " + year;
      list.appendChild(li);
    });

    Object.keys(existing).forEach(function(slot){
      if (!keep[slot]) existing[slot].remove();
    });
  }

  function updateRankText(entries: RankEntry[], movers: MoverEntry[],
      topRise: MoverEntry | undefined, topFall: MoverEntry | undefined, sharedScale: boolean){
    var meta = DATA.metricMeta[rankMetric];
    var year = YEARS[currentYearIdx];
    var reporting = entries.length + " of " + COUNTRIES_SORTED.length + " countries report";
    element("rankTopMeta").textContent = reporting;
    element("rankBottomMeta").textContent = reporting;

    var share = isShareMetric(rankMetric);
    var basisWord = currentYearIdx === 0
      ? ""
      : share
      ? meta.label + " is already a percentage, so its movers are measured in percentage points, never as a percent of a percent."
      : rankBasis === "pct"
        ? "Percent change from " + YEARS[0] + " to " + year + ". Each list is scaled to itself, because a rise has no ceiling while a fall can never pass 100%, so the two full bars do not stand for the same size of change. Countries that started from zero are left out."
        : "Change from " + YEARS[0] + " to " + year + ", in " + meta.unit + ". Both lists share one scale, so a fall can outrun a rise.";
    element("rankMoveSub").textContent = basisWord;

    var moverMeta = movers.length + " of " + COUNTRIES_SORTED.length + " countries report both years";
    // On a shared scale the bar lengths already compare; on separate scales each
    // card has to say what its own full bar is worth.
    element("rankRiseMeta").textContent = !movers.length ? ""
      : sharedScale || !topRise ? moverMeta
      : "Full bar " + fmtMover(topRise.delta, rankMetric) + " · " + moverMeta;
    element("rankFallMeta").textContent = !movers.length ? ""
      : sharedScale || !topFall ? moverMeta
      : "Full bar " + fmtMover(topFall.delta, rankMetric) + " · " + moverMeta;

    element("rankCaption").textContent =
      meta.label + " (" + meta.unit + ") in " + year + ". "
      + "Highest and Lowest share one scale, and every bar carries the same six bands as the World View map. "
      + "Your three countries are marked in their own colours. "
      + (PLANET_BETTER_WHEN[rankMetric]
        ? "Mover bars are green where the change is better for the planet and red where it is worse."
        : "Mover bars show growth or decline, which this metric does not judge as better or worse.");
  }

  function updateRankings(animate: boolean){
    var entries = rankedFor(rankMetric, currentYearIdx);
    var movers = moversFor(rankMetric, currentYearIdx);
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var flip = animate && !reduce;
    var lists = ["rankTopList", "rankBottomList", "rankRiseList", "rankFallList"];

    // Read every position before writing any, then write, then read once more:
    // two batched passes rather than a read/write interleave per row.
    const before = new Map<HTMLElement, number>();
    if (flip){
      lists.forEach(function(id){
        element(id).querySelectorAll<HTMLElement>(".rank-row:not([data-exit])").forEach(function(row){
          before.set(row, row.getBoundingClientRect().top);
        });
      });
    }

    var count = rankRows();
    var top = entries.slice(0, count);
    var bottom = entries.slice(-count).reverse();
    var levelScale = entries.length ? Math.max(entries[0].value, 0) : 0;
    var noLevel = "No country reports this metric for " + YEARS[currentYearIdx] + ".";
    syncRankList("rankTopList", levelRows(top, levelScale), noLevel);
    syncRankList("rankBottomList", levelRows(bottom, levelScale), noLevel);

    var rises = movers.filter(function(m){ return m.delta > 0; }).slice(0, count);
    var falls = movers.filter(function(m){ return m.delta < 0; }).slice(-count).reverse();
    var moverScale = Math.max(
      rises.length ? Math.abs(rises[0].delta) : 0,
      falls.length ? Math.abs(falls[0].delta) : 0
    );
    var sharedMoverScale = rankBasis === "abs";
    var riseScale = sharedMoverScale || !rises.length ? moverScale : Math.abs(rises[0].delta);
    var fallScale = sharedMoverScale || !falls.length ? moverScale : Math.abs(falls[0].delta);
    syncRankList("rankRiseList", moverRows(rises, riseScale), "No country rose since " + YEARS[0] + ".");
    syncRankList("rankFallList", moverRows(falls, fallScale), "No country fell since " + YEARS[0] + ".");

    var noMovers = !movers.length;
    element("rankMoversPair").hidden = noMovers;
    var empty = element("rankMoveEmpty");
    empty.hidden = !noMovers;
    empty.textContent = currentYearIdx === 0
      ? "Move the year past " + YEARS[0] + " to see how far countries have travelled."
      : "No country reports both " + YEARS[0] + " and " + YEARS[currentYearIdx] + " for this metric.";

    updateRankYours(entries);
    updateRankText(entries, movers, rises[0], falls[0], sharedMoverScale);

    if (!flip) return;
    const moves: { el: HTMLElement; dy: number }[] = [];
    lists.forEach(function(id){
      element(id).querySelectorAll<HTMLElement>(".rank-row:not([data-exit])").forEach(function(row){
        var was = before.get(row);
        if (was === undefined) return;
        var dy = was - row.getBoundingClientRect().top;
        if (Math.abs(dy) > 0.5) moves.push({ el: row, dy: dy });
      });
    });
    moves.forEach(function(move){
      move.el.style.transition = "none";
      move.el.style.transform = "translateY(" + move.dy.toFixed(1) + "px)";
    });
    if (moves.length) requestAnimationFrame(function(){
      moves.forEach(function(move){
        move.el.style.transition = "";
        move.el.style.transform = "";
      });
    });
  }

  // Percent of a percent misleads, so the share metrics are held to points.
  function syncRankBasisControl(){
    var share = isShareMetric(rankMetric);
    if (share) rankBasis = "abs";
    element("rankBasisAmount").textContent = share ? "Points" : "Amount";
    document.querySelectorAll<HTMLInputElement>("input[name=rankBasis]").forEach(function(input){
      input.checked = input.value === rankBasis;
      input.disabled = share && input.value === "pct";
    });
  }

  // ---------- Choropleth ----------
  type MapView = "level" | "change";
  interface BandSpec { edges: number[]; labels: string[]; }
  interface ChangeSpec extends BandSpec { mode: "pct" | "pts"; }
  interface MapCell { z: number | null; detail: string; band: number; }

  var mapView: MapView = new URLSearchParams(window.location.search).get("view") === "change" ? "change" : "level";

  // Fixed round-number bands, so a shade means the same range in every year.
  // Skewed metrics step by multiples so the largest countries separate.
  // `edges` are the thresholds between bands: a value joins the first band
  // whose upper edge is above it.
  var LEVEL_BANDS: Record<string, BandSpec> = {
    co2_per_capita: { edges: [1, 2, 5, 10, 20], labels: ["Under 1", "1–2", "2–5", "5–10", "10–20", "20+"] },
    co2: { edges: [1, 10, 100, 1000, 10000], labels: ["Under 1", "1–10", "10–100", "100–1,000", "1,000–10,000", "10,000+"] },
    share_global_co2: { edges: [0.01, 0.1, 1, 5, 20], labels: ["Under 0.01", "0.01–0.1", "0.1–1", "1–5", "5–20", "20+"] },
    gdp_per_capita: { edges: [2500, 5000, 10000, 25000, 50000], labels: ["Under $2.5k", "$2.5k–5k", "$5k–10k", "$10k–25k", "$25k–50k", "$50k+"] },
    renewables_share_energy: { edges: [5, 10, 20, 40, 60], labels: ["Under 5", "5–10", "10–20", "20–40", "40–60", "60+"] },
    population: { edges: [1e6, 1e7, 5e7, 1e8, 1e9], labels: ["Under 1M", "1M–10M", "10M–50M", "50M–100M", "100M–1B", "1B+"] }
  };

  // Change since 1990: percent for amounts, percentage points for metrics
  // that are already shares (a percent of a percent would mislead).
  var PCT_CHANGE: ChangeSpec = { mode: "pct", edges: [-50, -20, -5, 5, 50, 100],
    labels: ["Down 50%+", "Down 20–50%", "Down 5–20%", "Within ±5%", "Up 5–50%", "Up 50–100%", "Doubled or more"] };
  var CHANGE_BANDS: Record<string, ChangeSpec> = {
    co2_per_capita: PCT_CHANGE,
    co2: PCT_CHANGE,
    gdp_per_capita: PCT_CHANGE,
    population: PCT_CHANGE,
    share_global_co2: { mode: "pts", edges: [-1, -0.1, 0.1, 1],
      labels: ["Down 1+ pts", "Down 0.1–1 pts", "Within ±0.1 pts", "Up 0.1–1 pts", "Up 1+ pts"] },
    renewables_share_energy: { mode: "pts", edges: [-5, -1, 1, 5, 15],
      labels: ["Down 5+ pts", "Down 1–5 pts", "Within ±1 pt", "Up 1–5 pts", "Up 5–15 pts", "Up 15+ pts"] }
  };

  function bandIndex(edges: number[], v: number){
    return edges.filter(function(edge){ return v >= edge; }).length;
  }

  function hasNumber(v: number | null | undefined): v is number {
    return v !== null && v !== undefined && !isNaN(v);
  }

  // The "about the same" band sits between the negative and positive edges.
  function middleBand(spec: ChangeSpec){
    return spec.edges.filter(function(edge){ return edge < 0; }).length;
  }

  function fmtChange(delta: number, spec: ChangeSpec, metric: string){
    var sign = delta > 0 ? "+" : delta < 0 ? "−" : "";
    var size = Math.abs(delta);
    if (spec.mode === "pct") return sign + size.toFixed(size < 10 ? 1 : 0) + "%";
    return sign + size.toFixed(metric === "share_global_co2" ? 2 : 1) + " pts";
  }

  function changeVerdict(metric: string, band: number, spec: ChangeSpec){
    var mid = middleBand(spec);
    if (band === mid) return "About the same";
    var rising = band > mid;
    var better = PLANET_BETTER_WHEN[metric];
    if (!better) return rising ? "Growth" : "Decline";
    return (rising ? "up" : "down") === better ? "Better for the planet" : "Worse for the planet";
  }

  function mapCell(iso: string): MapCell {
    var meta = DATA.metricMeta[choroMetric];
    var year = YEARS[currentYearIdx];
    var v = valueAt(iso, choroMetric, currentYearIdx);
    if (!hasNumber(v)) return { z: null, band: -1, detail: "No data for " + year };
    if (mapView === "level"){
      var band = bandIndex(LEVEL_BANDS[choroMetric].edges, v);
      return { z: band + 0.5, band: band, detail: meta.label + ": " + fmtValue(v, choroMetric) };
    }
    var spec = CHANGE_BANDS[choroMetric];
    var base = valueAt(iso, choroMetric, 0);
    if (!hasNumber(base)) return { z: null, band: -1, detail: "No " + YEARS[0] + " value to compare" };
    if (spec.mode === "pct" && base === 0) return { z: null, band: -1, detail: "Zero in " + YEARS[0] + ", so no percent change" };
    var delta = spec.mode === "pct" ? (v - base) / base * 100 : v - base;
    var changeBand = bandIndex(spec.edges, delta);
    return {
      z: changeBand + 0.5,
      band: changeBand,
      detail: meta.label + ": " + fmtChange(delta, spec, choroMetric) + " since " + YEARS[0] +
        "<br>" + fmtValue(base, choroMetric) + " → " + fmtValue(v, choroMetric) +
        "<br>" + changeVerdict(choroMetric, changeBand, spec)
    };
  }

  // Strongest shade at the ends, lightest next to "about the same".
  function rampPick(ramp: string[], count: number){
    return count >= 3 ? ramp.slice(0, 3) : count === 2 ? [ramp[0], ramp[2]] : count === 1 ? [ramp[1]] : [];
  }

  function bandColors(): string[] {
    var t = theme();
    if (mapView === "level") return [t.seq[0], t.seq[1], t.seq[2], t.seq[3], t.seq[5], t.seq[6]];
    var spec = CHANGE_BANDS[choroMetric];
    var mid = middleBand(spec);
    var ramp = function(name: string){ return [getVar("--band-" + name + "-1"), getVar("--band-" + name + "-2"), getVar("--band-" + name + "-3")]; };
    var better = PLANET_BETTER_WHEN[choroMetric];
    var low = better ? ramp(better === "down" ? "good" : "bad") : ramp("decline");
    var high = better ? ramp(better === "down" ? "bad" : "good") : ramp("growth");
    return rampPick(low, mid).reverse()
      .concat([getVar("--band-mid")])
      .concat(rampPick(high, spec.labels.length - mid - 1));
  }

  // Plotly draws bands as a stepped colour scale over band indices.
  function steppedScale(colors: string[]): [number, string][] {
    var n = colors.length;
    var stops: [number, string][] = [];
    colors.forEach(function(color, i){ stops.push([i / n, color], [(i + 1) / n, color]); });
    return stops;
  }

  function mapCells(){
    return MAP_COUNTRIES.map(function(c){ return mapCell(c.iso3); });
  }

  function missingData(cells: MapCell[]){
    var isos: string[] = [], reasons: string[] = [];
    cells.forEach(function(cell, i){
      if (cell.z === null){ isos.push(MAP_COUNTRIES[i].iso3); reasons.push(cell.detail); }
    });
    return { isos: isos, reasons: reasons };
  }

  function renderChoropleth(){
    var t = theme();
    var locations = MAP_COUNTRIES.map(function(c){ return c.iso3; });
    var names = locations.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; });
    var cells = mapCells();
    var colors = bandColors();
    var hoverlabel = { bgcolor: t.surface, bordercolor: t.border, font: { color: t.text, family: t.fontFamily, size: 12 } };

    var trace = {
      type: "choropleth",
      locationmode: "ISO-3",
      locations: locations,
      z: cells.map(function(cell){ return cell.z; }),
      zmin: 0,
      zmax: colors.length,
      colorscale: steppedScale(colors),
      showscale: false,
      marker: { line: { color: t.surface, width: 0.5 } },
      text: names,
      customdata: cells.map(function(cell){ return cell.detail; }),
      hovertemplate: "<b>%{text}</b><br>%{customdata}<extra></extra>",
      hoverlabel: hoverlabel
    } as Data;

    // Countries without a value get their own neutral fill, so "no data"
    // never reads as the lowest shade. (The self-hosted atlas has no land layer.)
    var missing = missingData(cells);
    var noDataTrace = {
      type: "choropleth",
      locationmode: "ISO-3",
      // An empty choropleth breaks Plotly's hover, so hide it when every country reports.
      visible: missing.isos.length > 0,
      locations: missing.isos,
      z: missing.isos.map(function(){ return 1; }),
      colorscale: [[0, t.grid], [1, t.grid]],
      showscale: false,
      marker: { line: { color: t.surface, width: 0.5 } },
      text: missing.isos.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; }),
      customdata: missing.reasons,
      hovertemplate: "<b>%{text}</b><br>%{customdata}<extra></extra>",
      hoverlabel: hoverlabel
    } as Data;

    // The three selected countries are outlined in their series colours, the
    // same identity they carry in the table, bubble chart and trends.
    // A wider page-coloured stroke underneath keeps each outline legible
    // even where it crosses a fill of the same hue.
    var focusIsos = highlighted.filter(function(iso){ return iso && MAP_ISOS.has(iso); });
    var outline = function(iso: string, color: string, width: number){
      return {
        type: "choropleth",
        locationmode: "ISO-3",
        locations: [iso],
        z: [1],
        colorscale: [[0, "rgba(0,0,0,0)"], [1, "rgba(0,0,0,0)"]],
        showscale: false,
        marker: { line: { color: color, width: width } },
        hoverinfo: "skip"
      } as Data;
    };
    var focusTraces: Data[] = focusIsos.map(function(iso){ return outline(iso, t.surface, 4); })
      .concat(highlighted.map(function(iso, slot){
        return iso && MAP_ISOS.has(iso) ? outline(iso, SERIES_COLORS_LIVE()[slot], 1.8) : null;
      }).filter((trace): trace is Data => trace !== null));

    // showcountries draws every country's outline (from the same self-hosted
    // world_110m.json below), so a country with no value for this metric still
    // reads as "on the map, just uncolored" rather than vanishing into the ocean.
    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface,
      plot_bgcolor: t.surface,
      font: { color: t.text, family: t.fontFamily },
      margin: { l:0, r:0, t:0, b:0 },
      geo: {
        scope: "world",
        resolution: 110,
        showframe: false,
        showcoastlines: false,
        showland: false,
        showocean: false,
        showcountries: true,
        countrycolor: t.surface,
        showlakes: false,
        projection: { type: "natural earth" },
        // Antarctica carries no data; cropping it gives the inhabited world the room.
        lataxis: { range: [-57, 84] },
        bgcolor: t.surface
      }
    };

    updateMapText();
    renderMapLegend(colors);
    updateChoroplethReadout();
    // Plotly's default base-map atlas streams from Plotly's own CDN at draw
    // time; topojsonURL redirects that one request to a same-origin file
    // (world_110m.json, published next to this page) built from Natural Earth
    // 110m data, so nothing is fetched from an external host at runtime.
    return Plotly.react("choroplethChart", ([trace, noDataTrace] as Data[]).concat(focusTraces), layout, {displayModeBar:false, responsive:true, topojsonURL:assetBase});
  }

  function updateChoroplethYear(){
    var cells = mapCells();
    var missing = missingData(cells);
    Plotly.restyle("choroplethChart", {
      z: [cells.map(function(cell){ return cell.z; })],
      customdata: [cells.map(function(cell){ return cell.detail; })]
    }, [0]);
    // Restyle takes one array per trace; Plotly's types model single values only.
    Plotly.restyle("choroplethChart", {
      visible: [missing.isos.length > 0],
      locations: [missing.isos],
      z: [missing.isos.map(function(){ return 1; })],
      text: [missing.isos.map(function(iso){ return COUNTRIES_BY_ISO[iso].name; })],
      customdata: [missing.reasons]
    } as unknown as Data, [1]);
    updateMapText();
    updateChoroplethReadout();
  }

  function setMapView(view: MapView){
    mapView = view;
    // Keep the view in the address so a shared link opens the same map.
    var url = new URL(window.location.href);
    if (view === "change") url.searchParams.set("view", "change"); else url.searchParams.delete("view");
    window.history.replaceState(null, "", url);
    renderChoropleth();
  }

  function updateMapText(){
    var meta = DATA.metricMeta[choroMetric];
    var year = YEARS[currentYearIdx];
    var isShare = CHANGE_BANDS[choroMetric].mode === "pts";
    element("choroSub").textContent = mapView === "level"
      ? "Colored by " + meta.label + " (" + meta.unit + ") for the selected year."
      : "Colored by the change in " + meta.label + " since " + YEARS[0] + ".";
    var noDataNote = choroMetric === "renewables_share_energy"
      ? "Gray countries have no reliable energy-mix data for this metric."
      : "Gray countries have no data for this metric in this year.";
    element("choroCaption").textContent = mapView === "level"
      ? "Shades use fixed bands, so a color means the same range in every year. " + noDataNote
      : "Each country's change from " + YEARS[0] + " to the selected year" +
        (isShare ? ", in percentage points because this metric is already a share" : "") +
        ". Gray countries have no value for one of those years.";
    element("choroplethChart").setAttribute("aria-label", mapView === "level"
      ? "World map of " + meta.label + " (" + meta.unit + ") in " + year + ". Values and ranks for your selected countries are listed beside the map."
      : "World map of the change in " + meta.label + " from " + YEARS[0] + " to " + year + ". The change for your selected countries is listed beside the map.");
  }

  function renderMapLegend(colors: string[]){
    var meta = DATA.metricMeta[choroMetric];
    var spec = mapView === "level" ? LEVEL_BANDS[choroMetric] : CHANGE_BANDS[choroMetric];
    var title = mapView === "level"
      ? meta.label + " (" + meta.unit + ")"
      : "Change since " + YEARS[0] + (PLANET_BETTER_WHEN[choroMetric]
        ? ": green is better for the planet, red is worse"
        : ": growth or decline, not better or worse");
    var chips = spec.labels.map(function(label, i){
      return '<li class="map-legend-chip"><span class="map-legend-swatch" style="background:' + colors[i] + '"></span>' + label + '</li>';
    }).join("");
    element("choroLegend").innerHTML =
      '<p class="map-legend-title">' + title + '</p>' +
      '<ul class="map-legend-list">' + chips +
      '<li class="map-legend-chip"><span class="map-legend-swatch" style="background:' + theme().grid + '"></span>No data</li></ul>';
  }

  function ordinal(n: number){
    var tens = n % 100, ones = n % 10;
    if (tens >= 11 && tens <= 13) return n + "th";
    return n + (ones === 1 ? "st" : ones === 2 ? "nd" : ones === 3 ? "rd" : "th");
  }

  // The exact figure for each selected country, with its world rank (Level)
  // or its change and verdict (Change): the map's answer without hovering,
  // and its text alternative for screen readers.
  function updateChoroplethReadout(){
    var year = YEARS[currentYearIdx];
    var colors = SERIES_COLORS_LIVE();
    var list = element("choroFocus");
    if (!highlighted.some(Boolean)){
      list.innerHTML = '<li class="text-[12.5px] text-muted">Pick countries above to see where they stand.</li>';
      return;
    }
    if (mapView === "change" && currentYearIdx === 0){
      list.innerHTML = '<li class="text-[12.5px] text-muted">Move the year past ' + YEARS[0] + ' to see change.</li>';
      return;
    }
    var reported = COUNTRIES_SORTED
      .map(function(c){ return valueAt(c.iso3, choroMetric, currentYearIdx); })
      .filter(hasNumber);
    var spec = CHANGE_BANDS[choroMetric];
    list.innerHTML = highlighted.map(function(iso, slot){
      if (!iso) return "";
      var v = valueAt(iso, choroMetric, currentYearIdx);
      var value = "—", note = "No data for " + year;
      if (mapView === "level" && hasNumber(v)){
        var current = v;
        value = fmtValue(current, choroMetric);
        note = ordinal(reported.filter(function(other){ return other > current; }).length + 1) + " highest of " + reported.length;
      } else if (mapView === "change" && hasNumber(v)){
        var base = valueAt(iso, choroMetric, 0);
        if (!hasNumber(base) || (spec.mode === "pct" && base === 0)){
          note = "No " + YEARS[0] + " value to compare";
        } else {
          var delta = spec.mode === "pct" ? (v - base) / base * 100 : v - base;
          value = fmtChange(delta, spec, choroMetric);
          note = "Since " + YEARS[0] + " · " + changeVerdict(choroMetric, bandIndex(spec.edges, delta), spec).toLowerCase();
        }
      }
      return '<li class="map-focus-item">' +
        '<span class="swatch" style="background:' + colors[slot] + '"></span>' +
        '<span class="map-focus-name">' + COUNTRIES_BY_ISO[iso].name + '</span>' +
        '<span class="map-focus-value">' + value + '</span>' +
        '<span class="map-focus-rank">' + note + '</span></li>';
    }).join("");
  }

  // ---------- Scatter ----------
  function scatterFrameData(){
    const contextIso: string[] = [], contextX: number[] = [], contextY: number[] = [], contextSize: number[] = [], contextText: string[] = [];
    const seriesData: Bubble[][] = [[],[],[]]; // per highlighted slot: {iso,x,y,size,text}

    COUNTRIES_SORTED.forEach(function(c){
      var x = valueAt(c.iso3, scatterXMetric, currentYearIdx);
      var y = valueAt(c.iso3, scatterYMetric, currentYearIdx);
      var pop = valueAt(c.iso3, "population", currentYearIdx);
      if (x === null || y === null || x === undefined || y === undefined) return;
      if (x <= 0 && axisType(scatterXMetric) === "log") return;
      if (y <= 0 && axisType(scatterYMetric) === "log") return;
      var slot = highlighted.indexOf(c.iso3);
      var size = pop || (maxPopulation * 0.002);
      if (slot === -1){
        contextIso.push(c.iso3); contextX.push(x); contextY.push(y); contextSize.push(size); contextText.push(c.name);
      } else {
        seriesData[slot].push({x:x,y:y,size:size,text:c.name});
      }
    });
    return { contextX:contextX, contextY:contextY, contextSize:contextSize, contextText:contextText, seriesData:seriesData };
  }

  function bubbleSizeref(){
    return 2.0 * maxPopulation / Math.pow(46, 2);
  }

  function renderScatter(){
    var t = theme();
    var f = scatterFrameData();
    var xMeta = DATA.metricMeta[scatterXMetric], yMeta = DATA.metricMeta[scatterYMetric];

    var traces: Data[] = [{
      type: "scattergl", mode: "markers", name: "Other countries",
      x: f.contextX, y: f.contextY, text: f.contextText,
      marker: { size: f.contextSize, sizemode:"area", sizeref: bubbleSizeref(), sizemin:3,
                color: t.context, opacity:0.55, line:{width:0} },
      hovertemplate: "%{text}<br>" + xMeta.label + ": %{x}<br>" + yMeta.label + ": %{y}<extra></extra>",
      showlegend:false
    }];

    [0,1,2].forEach(function(slot){
      var iso = highlighted[slot];
      if (!iso) return;
      var rows = f.seriesData[slot];
      if (!rows.length) return;
      traces.push({
        type:"scattergl", mode:"text+markers", name: COUNTRIES_BY_ISO[iso].name,
        x: rows.map(function(r){return r.x;}), y: rows.map(function(r){return r.y;}),
        text: rows.map(function(r){return r.text;}), textposition:"top center",
        textfont: { color: t.text, size: 11, family: t.fontFamily },
        marker: { size: rows.map(function(r){return r.size;}), sizemode:"area", sizeref: bubbleSizeref(), sizemin:6,
                  color: SERIES_COLORS_LIVE()[slot], line:{ color:t.surface, width:1.5 } },
        hovertemplate: "<b>%{text}</b><br>" + xMeta.label + ": %{x}<br>" + yMeta.label + ": %{y}<extra></extra>",
        showlegend:false
      });
    });

    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface, plot_bgcolor: t.surface,
      font: { color: t.textSecondary, family: t.fontFamily, size:12 },
      margin: { l:64, r:20, t:10, b:52 },
      xaxis: { title:{text:metricLabel(scatterXMetric)}, type:axisType(scatterXMetric),
                gridcolor:t.grid, zerolinecolor:t.axis, linecolor:t.axis, tickfont:{color:t.textSecondary} },
      yaxis: { title:{text:metricLabel(scatterYMetric)}, type:axisType(scatterYMetric),
                gridcolor:t.grid, zerolinecolor:t.axis, linecolor:t.axis, tickfont:{color:t.textSecondary} }
    };

    return Plotly.react("scatterChart", traces, layout, {displayModeBar:false, responsive:true});
  }

  function SERIES_COLORS_LIVE(){
    return [getVar("--accent"), getVar("--accent-2"), getVar("--accent-3")];
  }

  function updateScatterYear(){
    renderScatter();
  }

  // ---------- Small multiples ----------
  // Row one: emissions. Row two: the economy, people, and energy context behind them.
  var SM_METRICS = ["co2_per_capita","co2","share_global_co2","gdp_per_capita","population","renewables_share_energy"];

  function renderSmallMultiples(){
    var grid = element("smGrid");
    var anyHighlighted = highlighted.some(function(i){ return !!i; });
    if (!anyHighlighted){
      grid.innerHTML = '<p class="empty-note">Pick at least one country above to see its trends.</p>';
      return;
    }
    if (grid.children.length !== SM_METRICS.length || grid.dataset.built !== "1"){
      grid.innerHTML = "";
      SM_METRICS.forEach(function(metric){
        var cell = document.createElement("div");
        cell.className = "sm-cell";
        cell.innerHTML = '<p class="sm-title">'+DATA.metricMeta[metric].label+' ('+DATA.metricMeta[metric].unit+')</p>' +
                          '<div class="chart-sm" id="sm-'+metric+'"></div>';
        grid.appendChild(cell);
      });
      grid.dataset.built = "1";
    }
    return Promise.all(SM_METRICS.map(renderSmallMultiple));
  }

  function renderSmallMultiple(metric: string){
    var t = theme();
    var traces: TrendTrace[] = [];
    [0,1,2].forEach(function(slot){
      var iso = highlighted[slot];
      if (!iso) return;
      var series = seriesAt(iso, metric);
      if (!series) return;
      const xs: number[] = [], ys: number[] = [];
      series.forEach(function(v,i){ if (v!==null && v!==undefined){ xs.push(YEARS[i]); ys.push(v); } });
      if (!xs.length) return;
      traces.push({
        type:"scatter", mode:"lines", name: COUNTRIES_BY_ISO[iso].name,
        x: xs, y: ys,
        line: { color: SERIES_COLORS_LIVE()[slot], width:2, shape:"spline", smoothing:0.3 },
        hovertemplate: "<b>"+COUNTRIES_BY_ISO[iso].name+"</b><br>%{x}: %{y" + (metric === "population" ? ":,.0f" : "") + "}<extra></extra>",
        showlegend:false
      });
    });

    var annotations: Partial<Annotations>[] = traces.map(function(tr){
      var lastX = tr.x[tr.x.length-1], lastY = tr.y[tr.y.length-1];
      return { x:lastX, y:lastY, text:tr.name, xanchor:"left", showarrow:false,
                font:{color:tr.line.color, size:10, family:theme().fontFamily}, xshift:6 };
    });
    separateEndLabels(annotations, traces, metric);

    var currentYear = YEARS[currentYearIdx];
    var shapes: Partial<Shape>[] = [{ type:"line", x0:currentYear, x1:currentYear, y0:0, y1:1, yref:"paper",
                    line:{ color:t.textMuted, width:1, dash:"dot" } }];

    var layout: Partial<Layout> = {
      paper_bgcolor: t.surface, plot_bgcolor: t.surface,
      font: { color: t.textSecondary, family: t.fontFamily, size:10 },
      margin: { l:34, r:44, t:6, b:22 },
      xaxis: { gridcolor:"transparent", linecolor:t.axis, tickfont:{size:10}, tickvals:[YEARS[0], Math.round((YEARS[0] + YEARS[YEARS.length - 1]) / 2), YEARS[YEARS.length - 1]] },
      // "B" reads 1.4B for population where SI notation would print 1.4G.
      yaxis: { gridcolor:t.grid, zerolinecolor:t.axis, linecolor:"transparent", tickfont:{size:10}, exponentformat:"B" },
      shapes: shapes,
      annotations: annotations,
      showlegend:false
    };

    var elId = "sm-" + metric;
    if (document.getElementById(elId)){
      return Plotly.react(elId, traces, layout, {displayModeBar:false, responsive:true});
    }
  }

  // Countries that end on similar values (China and India on population) would
  // print their end labels on top of each other. Push labels apart vertically,
  // keeping each as close to its line's end as the minimum gap allows.
  function separateEndLabels(annotations: Partial<Annotations>[], traces: TrendTrace[], metric: string){
    if (annotations.length < 2) return;
    var el = document.getElementById("sm-" + metric);
    var plotHeight = Math.max(80, (el ? el.clientHeight : 230) - 28);
    var allY = traces.reduce(function(acc: number[], tr){ return acc.concat(tr.y); }, []);
    var min = Math.min(...allY), max = Math.max(...allY);
    var span = max - min || 1;
    var MIN_GAP = 13;
    var labels = annotations.map(function(a){
      var px = ((a.y as number) - min) / span * plotHeight;
      return { a: a, px: px, placed: px };
    }).sort(function(p, q){ return p.px - q.px; });
    for (var i = 1; i < labels.length; i++){
      labels[i].placed = Math.max(labels[i].placed, labels[i-1].placed + MIN_GAP);
    }
    // If pushing up ran past the top, slide the whole stack back down.
    var overflow = labels[labels.length-1].placed - plotHeight;
    if (overflow > 0){
      labels[labels.length-1].placed -= overflow;
      for (var j = labels.length - 2; j >= 0; j--){
        labels[j].placed = Math.min(labels[j].placed, labels[j+1].placed - MIN_GAP);
      }
    }
    labels.forEach(function(l){ l.a.yshift = Math.round(l.placed - l.px); });
  }

  function updateSmallMultipleMarkers(){
    var currentYear = YEARS[currentYearIdx];
    SM_METRICS.forEach(function(metric){
      var elId = "sm-" + metric;
      var el = document.getElementById(elId) as Partial<PlotlyHTMLElement> | null;
      if (!el || !el.data) return;
      Plotly.relayout(elId, {
        shapes: (el.layout?.shapes || []).map(shape => ({
          ...shape, x0: currentYear, x1: currentYear
        }))
      });
    });
  }

  // ---------- Comparison table ----------
  var TABLE_METRICS = ["co2_per_capita","co2","share_global_co2","gdp_per_capita","renewables_share_energy","population"];

  var TREND_PATHS = {
    up: "M10 15.5V4.5M5.5 9 10 4.5 14.5 9",
    down: "M10 4.5v11M5.5 11 10 15.5 14.5 11"
  };

  // Which direction helps the planet. GDP and population have no clear
  // planetary reading, so their arrows stay neutral.
  var PLANET_BETTER_WHEN: Record<string, "up" | "down"> = {
    co2_per_capita: "down",
    co2: "down",
    share_global_co2: "down",
    renewables_share_energy: "up"
  };

  // Direction measured against the previous year.
  function trendMark(iso: string, metric: string, value: number | null){
    var prev = currentYearIdx > 0 ? valueAt(iso, metric, currentYearIdx - 1) : null;
    if (value === null || value === undefined || prev === null || prev === undefined || isNaN(value) || isNaN(prev) || value === prev){
      return '<span class="trend" aria-hidden="true"></span>';
    }
    var dir: "up" | "down" = value > prev ? "up" : "down";
    var change = prev !== 0 ? Math.abs((value - prev) / prev * 100) : null;
    var detail = (dir === "up" ? "Up" : "Down") + (change !== null ? " " + (change < 0.1 ? "under 0.1" : change.toFixed(1)) + "%" : "") + " from " + YEARS[currentYearIdx - 1];
    var better = PLANET_BETTER_WHEN[metric];
    var impact = better ? (dir === better ? "good" : "bad") : "";
    if (impact) detail += impact === "good" ? ", better for the planet" : ", worse for the planet";
    return '<span class="trend' + (impact ? " trend-" + impact : "") + '" title="' + detail + '">' +
      '<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="' + TREND_PATHS[dir] + '" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
      '<span class="sr-only">' + detail + '</span></span>';
  }

  function updateCompareTable(){
    var table = element("compareTable");
    var rows = highlighted.map(function(iso, slot){ return iso ? {iso:iso, slot:slot} : null; }).filter(row => row !== null);
    if (!rows.length){
      table.innerHTML = '';
      element("compareEmpty").hidden = false;
      table.hidden = true;
      return;
    }
    element("compareEmpty").hidden = true;
    table.hidden = false;
    var thead = "<thead><tr><th>Country</th>" + TABLE_METRICS.map(function(m){
      return "<th>" + DATA.metricMeta[m].label + "</th>";
    }).join("") + "</tr></thead>";
    var tbody = "<tbody>" + rows.map(function(r){
      var c = COUNTRIES_BY_ISO[r.iso];
      var cells = TABLE_METRICS.map(function(m){
        var v = valueAt(r.iso, m, currentYearIdx);
        return '<td><span class="metric-value">' + fmtValue(v, m) + trendMark(r.iso, m, v) + "</span></td>";
      }).join("");
      return '<tr><td class="country-cell"><span class="swatch" style="background:' + SERIES_COLORS_LIVE()[r.slot] + '"></span>' + c.name + '</td>' + cells + '</tr>';
    }).join("") + "</tbody>";
    table.innerHTML = thead + tbody;
  }

}

initAtlas();
</script>
